@{
    ViewData["Title"] = "Staff Dashboard";
    Layout = "_PortalLayout";
    
    var data = ViewBag.DashboardData;
}

<div class="premium-card mb-4 bg-primary text-white" style="border-radius: 15px; background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);">
    <div class="row align-items-center p-4">
        <div class="col-md-8">
            <h2 class="fw-bold mb-2">Xin chào, Lễ Tân!</h2>
            <p class="mb-0 text-white-50 fs-5">Chào mừng bạn đến với ca làm việc. Hãy cùng mang lại trải nghiệm tốt nhất cho bệnh nhân nhé.</p>
        </div>
        <div class="col-md-4 text-end d-none d-md-block">
            <i class="fas fa-headset fa-5x text-white opacity-50"></i>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Total Patients -->
    <div class="col-12 col-md-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-body p-4 position-relative">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="text-muted fw-bold mb-0 text-uppercase">Bệnh nhân</h6>
                    <div class="icon-shape bg-primary bg-opacity-10 text-primary rounded-circle p-3">
                        <i class="fas fa-users fs-4"></i>
                    </div>
                </div>
                <h2 class="fw-bold mb-1">@(data?.TotalPatients ?? 0)</h2>
                <span class="text-success small fw-bold"><i class="fas fa-arrow-up"></i> Tổng hồ sơ</span>
            </div>
            <div class="bg-primary position-absolute bottom-0 start-0 w-100" style="height: 4px;"></div>
        </div>
    </div>

    <!-- Today Appointments -->
    <div class="col-12 col-md-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-body p-4 position-relative">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="text-muted fw-bold mb-0 text-uppercase">Lịch khám h.nay</h6>
                    <div class="icon-shape bg-info bg-opacity-10 text-info rounded-circle p-3">
                        <i class="fas fa-calendar-day fs-4"></i>
                    </div>
                </div>
                <h2 class="fw-bold mb-1">@(data?.TodayAppointments ?? 0)</h2>
                <span class="text-muted small">Ca khám trong ngày</span>
            </div>
            <div class="bg-info position-absolute bottom-0 start-0 w-100" style="height: 4px;"></div>
        </div>
    </div>

    <!-- Pending Appointments -->
    <div class="col-12 col-md-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-body p-4 position-relative">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="text-muted fw-bold mb-0 text-uppercase">Chờ xác nhận</h6>
                    <div class="icon-shape bg-warning bg-opacity-10 text-warning rounded-circle p-3">
                        <i class="fas fa-clock fs-4"></i>
                    </div>
                </div>
                <h2 class="fw-bold mb-1">@(data?.PendingAppointments ?? 0)</h2>
                <span class="text-warning small fw-bold">Cần xử lý ngay</span>
            </div>
            <div class="bg-warning position-absolute bottom-0 start-0 w-100" style="height: 4px;"></div>
        </div>
    </div>

    <!-- Active Doctors -->
    <div class="col-12 col-md-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-body p-4 position-relative">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="text-muted fw-bold mb-0 text-uppercase">Bác sĩ trực</h6>
                    <div class="icon-shape bg-success bg-opacity-10 text-success rounded-circle p-3">
                        <i class="fas fa-user-md fs-4"></i>
                    </div>
                </div>
                <h2 class="fw-bold mb-1">@(data?.ActiveDoctors ?? 0)</h2>
                <span class="text-success small fw-bold">Sẵn sàng nhận bệnh</span>
            </div>
            <div class="bg-success position-absolute bottom-0 start-0 w-100" style="height: 4px;"></div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="premium-card h-100">
            <h4 class="fw-bold mb-4"><i class="fas fa-bolt text-warning me-2"></i> Thao tác nhanh</h4>
            <div class="d-grid gap-3">
                <a asp-controller="BenhNhan" asp-action="Create" class="btn btn-outline-primary btn-lg text-start p-3" style="border-radius: 12px;">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary text-white rounded p-3 me-3">
                            <i class="fas fa-user-plus fs-4"></i>
                        </div>
                        <div>
                            <h5 class="mb-1 fw-bold">Tạo Hồ sơ Bệnh nhân mới</h5>
                            <p class="mb-0 text-muted small">Đăng ký cho bệnh nhân lần đầu đến khám</p>
                        </div>
                    </div>
                </a>
                
                <a asp-controller="LichKham" asp-action="Create" class="btn btn-outline-info btn-lg text-start p-3" style="border-radius: 12px;">
                    <div class="d-flex align-items-center">
                        <div class="bg-info text-white rounded p-3 me-3">
                            <i class="fas fa-calendar-plus fs-4"></i>
                        </div>
                        <div>
                            <h5 class="mb-1 fw-bold">Tạo Lịch khám trực tiếp</h5>
                            <p class="mb-0 text-muted small">Phân bổ bệnh nhân vào phòng khám ngay</p>
                        </div>
                    </div>
                </a>
                
                <a asp-controller="PhieuKham" asp-action="Index" class="btn btn-outline-success btn-lg text-start p-3" style="border-radius: 12px;">
                    <div class="d-flex align-items-center">
                        <div class="bg-success text-white rounded p-3 me-3">
                            <i class="fas fa-stethoscope fs-4"></i>
                        </div>
                        <div>
                            <h5 class="mb-1 fw-bold">Kiểm tra Hàng đợi khám</h5>
                            <p class="mb-0 text-muted small">Xem tiến độ các phòng khám và kết quả</p>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="premium-card h-100">
            <h4 class="fw-bold mb-4"><i class="fas fa-bullhorn text-danger me-2"></i> Thông báo nội bộ</h4>
            <div class="alert alert-warning border-0 shadow-sm" style="border-radius: 12px;">
                <h5 class="alert-heading fw-bold"><i class="fas fa-exclamation-triangle"></i> Lưu ý đầu ca</h5>
                <p>Kiểm tra kỹ thông tin CCCD và bảo hiểm y tế của bệnh nhân trước khi lập phiếu khám.</p>
                <hr>
                <p class="mb-0 small">Cập nhật lúc: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
            
            <div class="alert alert-info border-0 shadow-sm mt-3" style="border-radius: 12px;">
                <h5 class="alert-heading fw-bold"><i class="fas fa-info-circle"></i> Thông báo từ Giám đốc</h5>
                <p>Hôm nay bác sĩ Tuyết xin nghỉ phép, các ca đăng ký Nha Khoa vui lòng hẹn sang ngày mai.</p>
            </div>
        </div>
    </div>
</div>
