@{
    ViewData["Title"] = "Staff Dashboard";
    Layout = "_PortalLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 style="font-weight: 700; color: var(--admin-text-dark); margin-bottom: 2px;">Tiếp đón & Thu ngân</h4>
        <div style="color: var(--admin-text-muted); font-size: 0.9rem;">Chào mừng bạn đến với ca làm việc</div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="admin-card p-4 text-center">
            <h5 class="text-info"><i class="fas fa-concierge-bell fa-3x mb-3"></i></h5>
            <h4>Khu vực dành cho Y tá / Lễ tân</h4>
            <p class="text-muted">Chức năng quản lý bệnh nhân tại sảnh, tạo lịch hẹn mới, tính tiền và in hóa đơn.</p>
        </div>
    </div>
</div>
