@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    Layout = "_PortalLayout";
}

<div class="premium-card">
    <div class="row align-items-center mb-4">
        <div class="col-md-2 text-center">
            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mx-auto shadow" style="width: 100px; height: 100px; font-size: 2.5rem;">
                <i class="fas fa-user-nurse"></i>
            </div>
        </div>
        <div class="col-md-10">
            <h2 class="fw-bold mb-1">@User.Identity?.Name</h2>
            <p class="text-muted mb-0"><i class="fas fa-id-badge text-primary me-2"></i>Vai trò: Lễ tân / Y tá</p>
            <p class="text-muted"><i class="fas fa-envelope text-info me-2"></i>@User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value</p>
        </div>
    </div>
    
    <hr />
    
    <h5 class="fw-bold mt-4 mb-3"><i class="fas fa-info-circle text-primary me-2"></i>Thông tin chi tiết</h5>
    <div class="alert alert-info border-0 shadow-sm" style="border-radius: 12px;">
        Tính năng cập nhật hồ sơ đang được phát triển. Vui lòng liên hệ Quản trị viên để thay đổi mật khẩu hoặc cập nhật số điện thoại.
    </div>
</div>
