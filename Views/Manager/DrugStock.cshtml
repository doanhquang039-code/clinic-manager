@model List<MyMvcApp.Models.Thuoc>
@{
    ViewData["Title"] = "Kho thuốc & Vật tư";
    Layout = "_ManagerLayout";
    var search = ViewBag.CurrentSearch as string ?? "";
    var statusFilter = ViewBag.CurrentStatus as string ?? "";
    var pageIndex = ViewBag.PageIndex as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var totalCount = ViewBag.TotalCount as int? ?? Model.Count;
    var activeTab = ViewBag.ActiveTab as string ?? "list";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <div class="mgr-page-title">Kho thuốc & Vật tư</div>
        <div class="mgr-page-sub">Hệ thống quản lý tồn kho Dược chính P405, điều phối Nhà thuốc P102 và phê duyệt phiếu nhập hàng vật tư y tế</div>
    </div>
    <button class="mgr-btn-primary" data-bs-toggle="modal" data-bs-target="#addDrugModal">
        <i class="fas fa-plus"></i> Nhập kho hàng mới
    </button>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" style="border-radius:10px;border:none;background:#dcfce7;color:#166534;">
        <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="mgr-stat-card">
            <div class="mgr-stat-icon" style="background:#eff6ff;">
                <i class="fas fa-capsules" style="color:#3b82f6;"></i>
            </div>
            <div>
                <div class="mgr-stat-label">Tổng danh mục thuốc</div>
                <div class="mgr-stat-value">@ViewBag.TotalItems</div>
                <div class="mgr-stat-sub" style="color:#22c55e;">• Đang kinh doanh hoạt động</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="mgr-stat-card">
            <div class="mgr-stat-icon" style="background:#f0fdf4;">
                <i class="fas fa-dollar-sign" style="color:#22c55e;"></i>
            </div>
            <div>
                <div class="mgr-stat-label">Giá trị kho hàng</div>
                <div class="mgr-stat-value" style="font-size:1.2rem;">@String.Format("{0:N0}", ViewBag.StockValue)đ</div>
                <div class="mgr-stat-sub mgr-stat-trend-neutral">Vốn lưu kho tại P405</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="mgr-stat-card">
            <div class="mgr-stat-icon" style="background:#fffbeb;">
                <i class="fas fa-exclamation-triangle" style="color:#f59e0b;"></i>
            </div>
            <div>
                <div class="mgr-stat-label">Thuốc sắp hết hàng</div>
                <div class="mgr-stat-value">@ViewBag.LowStockCount</div>
                <div class="mgr-stat-sub mgr-stat-trend-warn">⚠ Cần bổ sung kho lập tức</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="mgr-stat-card">
            <div class="mgr-stat-icon" style="background:#fff1f2;">
                <i class="fas fa-clock" style="color:#ef4444;"></i>
            </div>
            <div>
                <div class="mgr-stat-label">Thuốc sắp hết hạn</div>
                <div class="mgr-stat-value">@ViewBag.NearExpiredCount</div>
                <div class="mgr-stat-sub" style="color:#ef4444;">Hạn sử dụng dưới 3 tháng</div>
            </div>
        </div>
    </div>
</div>

<!-- Table -->
<div class="mgr-table-container">
    <div class="mgr-table-header">
        <div class="mgr-tabs">
            <a href="?tab=list&search=@search" class="mgr-tab @(activeTab == "list" ? "active" : "")">
                <i class="fas fa-list"></i> Danh mục tồn kho
            </a>
            <a href="?tab=import&search=@search" class="mgr-tab @(activeTab == "import" ? "active" : "")">
                <i class="fas fa-file-invoice"></i> Duyệt phiếu nhập hàng
                @if ((int)(ViewBag.LowStockCount ?? 0) > 0)
                {
                    <span class="count">@ViewBag.LowStockCount</span>
                }
            </a>
        </div>
        <div class="ms-auto d-flex gap-2 align-items-center">
            <form method="get" class="mgr-input-icon">
                <input type="hidden" name="tab" value="@activeTab" />
                <i class="fas fa-search"></i>
                <input class="mgr-input" style="width:220px;padding-left:32px;" type="text" name="search"
                       value="@search" placeholder="Tìm mã thuốc, tên thuốc..." />
            </form>
            <select class="mgr-input" id="statusFilterSelect">
                <option value="">Tất cả trạng thái</option>
                <option value="low">Sắp hết</option>
                <option value="expired">Hết hạn</option>
                <option value="outofstock">Hết hàng</option>
            </select>
        </div>
    </div>

    <table class="mgr-table">
        <thead>
            <tr>
                <th>THUỐC</th>
                <th>ĐƠN VỊ & CÁCH DÙNG</th>
                <th>SỐ LƯỢNG TỒN KHO</th>
                <th>ĐƠN GIÁ BÁN</th>
                <th>HẠN SỬ DỤNG</th>
                <th style="text-align:center;">HÀNH ĐỘNG</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var pct = item.SoLuongTon > 0 ? Math.Min(100, item.SoLuongTon * 100 / 500) : 0;
                var barClass = item.SoLuongTon == 0 ? "bar-red" : item.SoLuongTon < 20 ? "bar-yellow" : "bar-blue";
                var isExpiring = item.HanSuDung.HasValue && item.HanSuDung.Value < DateTime.Today.AddMonths(3);
                var isExpired = item.HanSuDung.HasValue && item.HanSuDung.Value < DateTime.Today;
                <tr>
                    <td>
                        <div style="font-size:0.7rem;color:#94a3b8;font-family:monospace;">MED-@item.MaThuoc.ToString("D4")</div>
                        <div style="font-weight:700;color:#1a1d23;">@item.TenThuoc</div>
                    </td>
                    <td>
                        <div style="font-weight:500;">@item.DonViTinh</div>
                        <div style="font-size:0.75rem;color:#64748b;">Theo chỉ định bác sĩ</div>
                    </td>
                    <td style="min-width:150px;">
                        <div class="d-flex align-items-center gap-2">
                            <span style="font-weight:700;font-size:0.95rem;">@item.SoLuongTon</span>
                            <span style="font-size:0.75rem;color:#64748b;">@item.DonViTinh</span>
                            @if (item.SoLuongTon == 0)
                            {
                                <span style="background:#fee2e2;color:#dc2626;padding:1px 7px;border-radius:4px;font-size:0.7rem;font-weight:700;">Hết hàng</span>
                            }
                            else if (item.SoLuongTon < 20)
                            {
                                <span style="background:#fef3c7;color:#d97706;padding:1px 7px;border-radius:4px;font-size:0.7rem;font-weight:700;">Nguy cấp</span>
                            }
                        </div>
                        <div class="stock-bar mt-1">
                            <div class="stock-bar-fill @barClass" style="width:@pct%;"></div>
                        </div>
                        <div style="font-size:0.68rem;color:#94a3b8;margin-top:2px;">@pct% / 500</div>
                    </td>
                    <td>
                        <div style="font-weight:700;color:#1a1d23;">@String.Format("{0:N0}", item.DonGia)đ</div>
                        <div style="font-size:0.75rem;color:#94a3b8;">/ @item.DonViTinh</div>
                    </td>
                    <td>
                        @if (item.HanSuDung.HasValue)
                        {
                            <div style="font-weight:500;color:@(isExpired ? "#dc2626" : isExpiring ? "#d97706" : "#1a1d23");">
                                @item.HanSuDung.Value.ToString("dd/MM/yyyy")
                            </div>
                            if (isExpired)
                            {
                                <div style="font-size:0.72rem;color:#dc2626;">Đã hết hạn</div>
                            }
                            else if (isExpiring)
                            {
                                <div style="font-size:0.72rem;color:#d97706;">⚠ Sắp hết hạn</div>
                            }
                        }
                        else
                        {
                            <span style="color:#94a3b8;">—</span>
                        }
                    </td>
                    <td style="text-align:center;">
                        <div class="d-flex gap-1 justify-content-center">
                            <button class="action-btn" title="Chỉnh sửa"
                                    onclick="openEditDrug(@item.MaThuoc,'@item.TenThuoc.Replace("'","\\'")', '@item.DonViTinh', @item.DonGia, @item.SoLuongTon, '@item.HanSuDung?.ToString("yyyy-MM-dd")')">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="action-btn" title="Nhập thêm"
                                    onclick="openRestock(@item.MaThuoc, '@item.TenThuoc.Replace("'","\\'")', @item.SoLuongTon)">
                                <i class="fas fa-plus-circle"></i>
                            </button>
                            <form asp-action="DeleteDrug" method="post" style="display:inline;"
                                  onsubmit="return confirm('Xóa thuốc @item.TenThuoc.Replace("'","\'")? Không thể hoàn tác!')">
                                <input type="hidden" name="id" value="@item.MaThuoc" />
                                <button type="submit" class="action-btn danger" title="Xóa">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Pagination -->
    <div class="d-flex justify-content-between align-items-center px-4 py-3" style="border-top:1px solid #eef0f4;">
        <div style="font-size:0.82rem;color:#64748b;">Hiển thị @Model.Count / @totalCount loại thuốc</div>
        <div class="mgr-pagination">
            <a href="?search=@search&statusFilter=@statusFilter&page=@(pageIndex-1)" class="mgr-page-btn @(pageIndex<=1?"disabled":"")">
                <i class="fas fa-chevron-left"></i>
            </a>
            @for (int p = Math.Max(1,pageIndex-2); p <= Math.Min(totalPages,pageIndex+2); p++)
            {
                <a href="?search=@search&statusFilter=@statusFilter&page=@p" class="mgr-page-btn @(p==pageIndex?"active":"")">@p</a>
            }
            <a href="?search=@search&statusFilter=@statusFilter&page=@(pageIndex+1)" class="mgr-page-btn @(pageIndex>=totalPages?"disabled":"")">
                <i class="fas fa-chevron-right"></i>
            </a>
        </div>
    </div>
</div>

<!-- Modal Thêm thuốc -->
<div class="modal fade" id="addDrugModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius:14px;border:none;">
            <div class="modal-header" style="background:#1a237e;color:white;border-radius:14px 14px 0 0;padding:18px 24px;">
                <h5 class="modal-title"><i class="fas fa-pills me-2"></i> Thêm thuốc / Nhập kho</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateDrug" method="post">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold" style="font-size:0.85rem;">Tên thuốc *</label>
                            <input name="TenThuoc" class="mgr-input" style="width:100%;" required placeholder="Paracetamol 500mg..." />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size:0.85rem;">Đơn vị tính</label>
                            <input name="DonViTinh" class="mgr-input" style="width:100%;" placeholder="Viên / Gói / Lọ..." value="Viên" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size:0.85rem;">Đơn giá (đ)</label>
                            <input name="DonGia" type="number" class="mgr-input" style="width:100%;" placeholder="5000" min="0" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size:0.85rem;">Số lượng tồn</label>
                            <input name="SoLuongTon" type="number" class="mgr-input" style="width:100%;" placeholder="0" min="0" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size:0.85rem;">Hạn sử dụng</label>
                            <input name="HanSuDung" type="date" class="mgr-input" style="width:100%;" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4">
                    <button type="button" class="mgr-btn-outline" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="mgr-btn-primary"><i class="fas fa-save me-1"></i> Lưu thuốc</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Sửa thuốc -->
<div class="modal fade" id="editDrugModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius:14px;border:none;">
            <div class="modal-header" style="background:linear-gradient(135deg,#0ea5e9,#0284c7);color:white;border-radius:14px 14px 0 0;padding:18px 24px;">
                <h5 class="modal-title"><i class="fas fa-edit me-2"></i> Chỉnh sửa thuốc</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="EditDrug" method="post">
                <input type="hidden" id="editDrugId" name="id" />
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold" style="font-size:0.85rem;">Tên thuốc</label>
                            <input id="editDrugName" name="TenThuoc" class="mgr-input" style="width:100%;" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size:0.85rem;">Đơn vị</label>
                            <input id="editDrugUnit" name="DonViTinh" class="mgr-input" style="width:100%;" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size:0.85rem;">Đơn giá (đ)</label>
                            <input id="editDrugPrice" name="DonGia" type="number" class="mgr-input" style="width:100%;" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size:0.85rem;">Số lượng</label>
                            <input id="editDrugQty" name="SoLuongTon" type="number" class="mgr-input" style="width:100%;" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" style="font-size:0.85rem;">Hạn sử dụng</label>
                            <input id="editDrugExp" name="HanSuDung" type="date" class="mgr-input" style="width:100%;" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4">
                    <button type="button" class="mgr-btn-outline" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="mgr-btn-primary"><i class="fas fa-save me-1"></i> Lưu</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Nhập thêm kho -->
<div class="modal fade" id="restockModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content" style="border-radius:14px;border:none;">
            <div class="modal-header" style="background:linear-gradient(135deg,#22c55e,#16a34a);color:white;border-radius:14px 14px 0 0;padding:18px 24px;">
                <h5 class="modal-title"><i class="fas fa-boxes me-2"></i> Nhập thêm kho</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="RestockDrug" method="post">
                <input type="hidden" id="restockId" name="id" />
                <div class="modal-body p-4">
                    <div id="restockDrugName" style="font-weight:700;color:#1a1d23;margin-bottom:12px;"></div>
                    <div id="restockCurrentQty" style="font-size:0.82rem;color:#64748b;margin-bottom:16px;"></div>
                    <label class="form-label fw-semibold" style="font-size:0.85rem;">Số lượng nhập thêm *</label>
                    <input name="SoLuongNhap" type="number" class="mgr-input" style="width:100%;" min="1" placeholder="100" required />
                </div>
                <div class="modal-footer border-0 px-4 pb-4">
                    <button type="button" class="mgr-btn-outline" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="mgr-btn-primary" style="background:#22c55e;"><i class="fas fa-check me-1"></i> Xác nhận nhập</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
function openEditDrug(id, name, unit, price, qty, exp) {
    document.getElementById('editDrugId').value = id;
    document.getElementById('editDrugName').value = name;
    document.getElementById('editDrugUnit').value = unit;
    document.getElementById('editDrugPrice').value = price;
    document.getElementById('editDrugQty').value = qty;
    document.getElementById('editDrugExp').value = exp || '';
    new bootstrap.Modal(document.getElementById('editDrugModal')).show();
}
function openRestock(id, name, currentQty) {
    document.getElementById('restockId').value = id;
    document.getElementById('restockDrugName').textContent = name;
    document.getElementById('restockCurrentQty').textContent = 'Tồn kho hiện tại: ' + currentQty + ' đơn vị';
    new bootstrap.Modal(document.getElementById('restockModal')).show();
}
// Status filter
var sf = document.getElementById('statusFilterSelect');
if (sf) { sf.value = '@statusFilter'; sf.addEventListener('change', function(){ window.location='?search=@search&statusFilter='+this.value; }); }
</script>
}
