@model List<MyMvcApp.Models.BenhNhan>
@{
    ViewData["Title"] = "Hồ sơ Bệnh nhân";
    Layout = "_ManagerLayout";
    var search = ViewData["CurrentSearch"]?.ToString() ?? "";
    var pageIndex = ViewBag.PageIndex as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var totalCount = ViewBag.TotalCount as int? ?? Model.Count;
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <div class="mgr-page-title">Hồ sơ bệnh nhân</div>
        <div class="mgr-page-sub">Hệ thống tra cứu dữ liệu hành chính, giám sát lượng khám và kiểm toán lịch sử bệnh án toàn phòng khám</div>
    </div>
    <a href="#" class="mgr-btn-outline"><i class="fas fa-file-export"></i> Xuất báo cáo dữ liệu</a>
</div>

<!-- Filter bar -->
<div class="mgr-table-container mb-0">
    <form method="get" class="d-flex align-items-center gap-3 p-4" style="border-bottom:1px solid #eef0f4;flex-wrap:wrap;">
        <div class="mgr-input-icon" style="flex:1;min-width:260px;">
            <i class="fas fa-search"></i>
            <input class="mgr-input" style="width:100%;padding-left:36px;" type="text" name="search"
                   value="@search" placeholder="Tìm kiếm theo Mã BN, Họ tên, SĐT, CCCD..." />
        </div>
        <select name="loaibn" class="mgr-input">
            <option value="">Loại bệnh nhân</option>
            <option value="all">Tất cả</option>
        </select>
        <select name="tthoadon" class="mgr-input">
            <option value="">Trạng thái hóa đơn</option>
            <option value="paid">Đã thanh toán</option>
            <option value="unpaid">Chưa thanh toán</option>
        </select>
        <button type="submit" class="mgr-btn-primary"><i class="fas fa-search me-1"></i> Tìm</button>
        <span style="color:#64748b;font-size:0.82rem;">@totalCount kết quả</span>
    </form>

    <table class="mgr-table">
        <thead>
            <tr>
                <th>BỆNH NHÂN</th>
                <th>THÔNG TIN HÀNH CHÍNH</th>
                <th>CĂN CƯỚC CÔNG DÂN</th>
                <th>ĐỊA CHỈ</th>
                <th>TRẠNG THÁI HÓA ĐƠN</th>
                <th style="text-align:center;">HÀNH ĐỘNG</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var initials = string.Join("", item.HoTen.Split(' ').TakeLast(2).Select(w => w.Length > 0 ? w[0].ToString().ToUpper() : ""));
                var colors = new[] { "#6366f1","#0ea5e9","#22c55e","#f59e0b","#ef4444","#8b5cf6" };
                var bg = colors[Math.Abs(item.HoTen.GetHashCode()) % colors.Length];
                <tr>
                    <td>
                        <div style="font-size:0.72rem;color:#94a3b8;margin-bottom:2px;">BN-@DateTime.Now.Year-@item.MaBenhNhan.ToString("D3")</div>
                        <div style="font-weight:700;color:#1a1d23;">@item.HoTen</div>
                    </td>
                    <td>
                        <div style="font-weight:500;">@item.SoDienThoai</div>
                        <div style="font-size:0.78rem;color:#64748b;">@item.NgaySinh.ToString("yyyy") – @item.GioiTinh</div>
                    </td>
                    <td style="font-size:0.82rem;color:#475569;font-family:monospace;">@(item.CCCD ?? "—")</td>
                    <td style="font-size:0.82rem;color:#64748b;max-width:160px;">@(item.DiaChi ?? "—")</td>
                    <td>
                        @{
                            var lastInvoice = ViewBag.PatientInvoiceStatus as System.Collections.Generic.Dictionary<int, string>;
                            var invStatus = lastInvoice != null && lastInvoice.ContainsKey(item.MaBenhNhan) ? lastInvoice[item.MaBenhNhan] : null;
                        }
                        @if (invStatus == "DaThanhToan")
                        {
                            <span class="inv-paid">Đã thanh toán</span>
                        }
                        else if (invStatus == "ChuaThanhToan")
                        {
                            <span class="inv-unpaid">Chưa thanh toán</span>
                        }
                        else
                        {
                            <span style="color:#94a3b8;font-size:0.82rem;">—</span>
                        }
                    </td>
                    <td style="text-align:center;">
                        <div class="d-flex gap-1 justify-content-center">
                            <a href="#" class="action-btn" title="Xem hồ sơ"><i class="fas fa-eye"></i></a>
                            <a href="#" class="action-btn" title="Tải xuống"><i class="fas fa-download"></i></a>
                            <a href="#" class="action-btn danger" title="Xóa"><i class="fas fa-trash-alt"></i></a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Pagination -->
    <div class="d-flex justify-content-between align-items-center px-4 py-3" style="border-top:1px solid #eef0f4;">
        <div style="font-size:0.82rem;color:#64748b;">Hiển thị @Model.Count / @totalCount bệnh nhân</div>
        <div class="mgr-pagination">
            <a href="?search=@search&page=@(pageIndex-1)" class="mgr-page-btn @(pageIndex <= 1 ? "disabled" : "")">
                <i class="fas fa-chevron-left"></i>
            </a>
            @for (int p = Math.Max(1, pageIndex - 2); p <= Math.Min(totalPages, pageIndex + 2); p++)
            {
                <a href="?search=@search&page=@p" class="mgr-page-btn @(p == pageIndex ? "active" : "")">@p</a>
            }
            <a href="?search=@search&page=@(pageIndex+1)" class="mgr-page-btn @(pageIndex >= totalPages ? "disabled" : "")">
                <i class="fas fa-chevron-right"></i>
            </a>
        </div>
    </div>
</div>
