@{
    ViewData["Title"] = "Manager Dashboard";
    Layout = "_PortalLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 style="font-weight: 700; color: var(--admin-text-dark); margin-bottom: 2px;">Manager Dashboard</h4>
        <div style="color: var(--admin-text-muted); font-size: 0.9rem;">Tổng quan hoạt động phòng khám</div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="admin-card p-4 text-center">
            <h5 class="text-primary"><i class="fas fa-chart-line fa-3x mb-3"></i></h5>
            <h4>Khu vực dành riêng cho Giám đốc / Quản lý</h4>
            <p class="text-muted">Tính năng báo cáo tài chính, biểu đồ doanh thu sẽ được phát triển tại đây.</p>
        </div>
    </div>
</div>
