@model List<MyMvcApp.Models.LichKham>
@{
    ViewData["Title"] = "Dashboard Quản lý";
    Layout = "_PortalLayout";

    var weeklyData = ViewBag.WeeklyData as List<int> ?? new List<int>();
    var weeklyJson = System.Text.Json.JsonSerializer.Serialize(weeklyData);

    var labels = new List<string>();
    for (int i = 6; i >= 0; i--)
        labels.Add(DateTime.Today.AddDays(-i).ToString("ddd dd/MM"));
    var labelsJson = System.Text.Json.JsonSerializer.Serialize(labels);
}

<div class="mb-4">
    <h4 style="font-weight: 700; color: var(--admin-text-dark); margin-bottom: 2px;">Dashboard Quản lý</h4>
    <div style="color: var(--admin-text-muted); font-size: 0.9rem;">Tổng quan hoạt động phòng khám</div>
</div>

<!-- KPI Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="admin-card p-4" style="border-left: 4px solid #6366f1;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div style="font-size: 0.8rem; font-weight: 600; color: #6366f1; text-transform: uppercase; letter-spacing: 0.05em;">Bệnh nhân</div>
                    <div style="font-size: 2rem; font-weight: 700; color: #0f172a; line-height: 1.2;">@ViewBag.TotalBenhNhan</div>
                    <div style="font-size: 0.8rem; color: #64748b;">Tổng đã đăng ký</div>
                </div>
                <div style="width: 52px; height: 52px; border-radius: 14px; background: #ede9fe; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; color: #6366f1;">
                    <i class="fas fa-procedures"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="admin-card p-4" style="border-left: 4px solid #22c55e;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div style="font-size: 0.8rem; font-weight: 600; color: #22c55e; text-transform: uppercase; letter-spacing: 0.05em;">Bác sĩ</div>
                    <div style="font-size: 2rem; font-weight: 700; color: #0f172a; line-height: 1.2;">@ViewBag.TotalBacSi</div>
                    <div style="font-size: 0.8rem; color: #64748b;">Đang hoạt động</div>
                </div>
                <div style="width: 52px; height: 52px; border-radius: 14px; background: #dcfce7; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; color: #22c55e;">
                    <i class="fas fa-user-md"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="admin-card p-4" style="border-left: 4px solid #f59e0b;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div style="font-size: 0.8rem; font-weight: 600; color: #f59e0b; text-transform: uppercase; letter-spacing: 0.05em;">Lịch hôm nay</div>
                    <div style="font-size: 2rem; font-weight: 700; color: #0f172a; line-height: 1.2;">@ViewBag.LichHomNay</div>
                    <div style="font-size: 0.8rem; color: #64748b;">Chờ: @ViewBag.LichChoXacNhan / Xong: @ViewBag.LichHoanTat</div>
                </div>
                <div style="width: 52px; height: 52px; border-radius: 14px; background: #fef3c7; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; color: #f59e0b;">
                    <i class="fas fa-calendar-day"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="admin-card p-4" style="border-left: 4px solid #0ea5e9;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div style="font-size: 0.8rem; font-weight: 600; color: #0ea5e9; text-transform: uppercase; letter-spacing: 0.05em;">Doanh thu tháng</div>
                    <div style="font-size: 1.6rem; font-weight: 700; color: #0f172a; line-height: 1.2;">@String.Format("{0:N0}", ViewBag.RevenueThisMonth)đ</div>
                    <div style="font-size: 0.8rem; color: #64748b;">Tổng: @String.Format("{0:N0}", ViewBag.TotalRevenue)đ</div>
                </div>
                <div style="width: 52px; height: 52px; border-radius: 14px; background: #e0f2fe; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; color: #0ea5e9;">
                    <i class="fas fa-chart-line"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Biểu đồ lịch khám 7 ngày -->
    <div class="col-lg-7">
        <div class="admin-card p-4 h-100">
            <h6 style="font-weight: 600; color: #334155; margin-bottom: 1.5rem;"><i class="fas fa-chart-bar text-primary me-2"></i>Số ca khám 7 ngày gần nhất</h6>
            <canvas id="weeklyChart" height="200"></canvas>
        </div>
    </div>

    <!-- Lịch khám mới nhất -->
    <div class="col-lg-5">
        <div class="admin-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 style="font-weight: 600; color: #334155; margin: 0;"><i class="fas fa-clock text-warning me-2"></i>Lịch khám mới nhất</h6>
                <a asp-controller="Manager" asp-action="Patients" class="text-primary text-decoration-none" style="font-size: 0.85rem;">Xem tất cả →</a>
            </div>
            <div class="list-group list-group-flush">
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var statusColor = item.TrangThai == "DaXacNhan" ? "#22c55e" : "#f59e0b";
                        <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center" style="border-color: #f1f5f9;">
                            <div>
                                <div style="font-weight: 600; font-size: 0.9rem;">@item.BenhNhan?.HoTen</div>
                                <div style="font-size: 0.78rem; color: #64748b;">@item.NgayKham.ToString("dd/MM") — @item.BacSi?.HoTen</div>
                            </div>
                            <span style="font-size: 0.75rem; font-weight: 600; color: @statusColor; background: @(statusColor + "15"); padding: 3px 10px; border-radius: 20px;">
                                @(item.TrangThai == "DaXacNhan" ? "Đã khám" : "Chờ")
                            </span>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-muted py-4">Chưa có lịch khám nào.</div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const ctx = document.getElementById('weeklyChart').getContext('2d');
new Chart(ctx, {
    type: 'bar',
    data: {
        labels: @Html.Raw(labelsJson),
        datasets: [{
            label: 'Số ca khám',
            data: @Html.Raw(weeklyJson),
            backgroundColor: 'rgba(99, 102, 241, 0.15)',
            borderColor: '#6366f1',
            borderWidth: 2,
            borderRadius: 6,
            borderSkipped: false,
        }]
    },
    options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: {
            y: { beginAtZero: true, ticks: { stepSize: 1 }, grid: { color: '#f1f5f9' } },
            x: { grid: { display: false } }
        }
    }
});
</script>
}
