@model List<MyMvcApp.Models.LichKham>
@{
    ViewData["Title"] = "Tổng quan Quản lý";
    Layout = "_ManagerLayout";

    var weeklyData = ViewBag.WeeklyData as List<int> ?? new();
    var weeklyJson = System.Text.Json.JsonSerializer.Serialize(weeklyData);
    var labels = new List<string>();
    for (int i = 6; i >= 0; i--)
        labels.Add(DateTime.Today.AddDays(-i).ToString("ddd dd/MM", new System.Globalization.CultureInfo("vi-VN")));
    var labelsJson = System.Text.Json.JsonSerializer.Serialize(labels);
    var lowStockCount = ViewBag.LowStockCount as int? ?? 0;
}

<div class="mb-4">
    <div class="mgr-page-title">Tổng quan Quản lý</div>
    <div class="mgr-page-sub">Báo cáo tổng hợp tình hình vận hành và điều hành hoạt động phòng khám.</div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-5">
    <div class="col-md-3">
        <div class="mgr-stat-card">
            <div class="mgr-stat-icon" style="background:#eff6ff;">
                <i class="fas fa-chart-line" style="color:#3b82f6;"></i>
            </div>
            <div>
                <div class="mgr-stat-label">Tổng doanh thu</div>
                <div class="mgr-stat-value" style="font-size:1.25rem;">@String.Format("{0:N0}", ViewBag.TotalRevenue)đ</div>
                <div class="mgr-stat-sub mgr-stat-trend-up">↑ +12% so với tháng trước</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="mgr-stat-card">
            <div class="mgr-stat-icon" style="background:#f0fdf4;">
                <i class="fas fa-user-injured" style="color:#22c55e;"></i>
            </div>
            <div>
                <div class="mgr-stat-label">Lượt khám hôm nay</div>
                <div class="mgr-stat-value">@ViewBag.LichHomNay</div>
                <div class="mgr-stat-sub mgr-stat-trend-up">↑ +8% tăng trưởng</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="mgr-stat-card">
            <div class="mgr-stat-icon" style="background:#f5f3ff;">
                <i class="fas fa-procedures" style="color:#8b5cf6;"></i>
            </div>
            <div>
                <div class="mgr-stat-label">Bệnh nhân mới</div>
                <div class="mgr-stat-value">@ViewBag.TotalBenhNhan</div>
                <div class="mgr-stat-sub mgr-stat-trend-neutral">— Ổn định</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="mgr-stat-card">
            <div class="mgr-stat-icon" style="background:#fffbeb;">
                <i class="fas fa-exclamation-triangle" style="color:#f59e0b;"></i>
            </div>
            <div>
                <div class="mgr-stat-label">Thuốc sắp hết hạn</div>
                <div class="mgr-stat-value">@lowStockCount</div>
                <div class="mgr-stat-sub mgr-stat-trend-warn">⚠ Cần nhập hàng gấp</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Chart -->
    <div class="col-lg-8">
        <div class="mgr-table-container p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h6 style="font-weight:700;color:#1a1d23;margin:0;">Số ca khám 7 ngày gần nhất</h6>
                <a asp-action="Schedules" class="mgr-btn-outline" style="padding:6px 14px;font-size:0.78rem;">
                    Xem lịch <i class="fas fa-arrow-right ms-1"></i>
                </a>
            </div>
            <canvas id="weeklyChart" height="180"></canvas>
        </div>
    </div>

    <!-- Right panel -->
    <div class="col-lg-4">
        <!-- Quick stats -->
        <div class="row g-3 mb-3">
            <div class="col-6">
                <div class="mgr-stat-card" style="padding:14px 16px;">
                    <div>
                        <div class="mgr-stat-label">Bác sĩ</div>
                        <div style="font-size:1.5rem;font-weight:800;color:#1a1d23;">@ViewBag.TotalBacSi</div>
                        <div style="font-size:0.72rem;color:#22c55e;">● Đang hoạt động</div>
                    </div>
                </div>
            </div>
            <div class="col-6">
                <div class="mgr-stat-card" style="padding:14px 16px;">
                    <div>
                        <div class="mgr-stat-label">Chờ xác nhận</div>
                        <div style="font-size:1.5rem;font-weight:800;color:#1a1d23;">@ViewBag.LichChoXacNhan</div>
                        <div style="font-size:0.72rem;color:#f59e0b;">● Lịch khám chờ</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent appointments -->
        <div class="mgr-table-container h-auto">
            <div class="d-flex justify-content-between align-items-center px-4 py-3" style="border-bottom:1px solid #eef0f4;">
                <div style="font-weight:700;font-size:0.88rem;color:#1a1d23;">Lịch khám gần nhất</div>
                <a asp-action="Schedules" style="font-size:0.78rem;color:#1a237e;text-decoration:none;">Xem tất cả →</a>
            </div>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="d-flex align-items-center gap-3 px-4 py-2" style="border-bottom:1px solid #f8fafc;">
                        <div style="width:32px;height:32px;border-radius:50%;background:#eef2ff;display:flex;align-items:center;justify-content:center;font-size:0.7rem;font-weight:700;color:#6366f1;flex-shrink:0;">
                            @item.BenhNhan?.HoTen.Substring(0, 1)
                        </div>
                        <div style="flex:1;min-width:0;">
                            <div style="font-weight:600;font-size:0.82rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@item.BenhNhan?.HoTen</div>
                            <div style="font-size:0.72rem;color:#94a3b8;">@item.NgayKham.ToString("dd/MM") – @item.BacSi?.HoTen</div>
                        </div>
                        @if (item.TrangThai == "DaXacNhan")
                        {
                            <span style="font-size:0.7rem;font-weight:700;color:#166534;background:#dcfce7;padding:2px 8px;border-radius:12px;">Đã khám</span>
                        }
                        else
                        {
                            <span style="font-size:0.7rem;font-weight:700;color:#92400e;background:#fef3c7;padding:2px 8px;border-radius:12px;">Chờ</span>
                        }
                    </div>
                }
            }
            else
            {
                <div class="text-center text-muted py-4" style="font-size:0.85rem;">Chưa có lịch khám nào.</div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
new Chart(document.getElementById('weeklyChart').getContext('2d'), {
    type: 'bar',
    data: {
        labels: @Html.Raw(labelsJson),
        datasets: [{
            label: 'Số ca khám',
            data: @Html.Raw(weeklyJson),
            backgroundColor: 'rgba(26,35,126,0.08)',
            borderColor: '#1a237e',
            borderWidth: 2, borderRadius: 7, borderSkipped: false,
        }]
    },
    options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: {
            y: { beginAtZero: true, ticks: { stepSize: 1 }, grid: { color: '#f8fafc' } },
            x: { grid: { display: false } }
        }
    }
});
</script>
}
