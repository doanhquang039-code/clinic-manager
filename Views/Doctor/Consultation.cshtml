@model MyMvcApp.Models.PhieuKham
@{
    ViewData["Title"] = "Khám Bệnh";
    Layout = "_PortalLayout";
    
    var appointment = ViewBag.Appointment as MyMvcApp.Models.LichKham;
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted mb-2 d-inline-block"><i class="fas fa-arrow-left me-1"></i> Quay lại Danh sách</a>
    <h4 style="font-weight: 700; color: var(--admin-text-dark); margin-bottom: 2px;">Phiếu Khám Bệnh</h4>
    <div style="color: var(--admin-text-muted); font-size: 0.9rem;">Thực hiện khám chuyên khoa</div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert" style="border-radius: 8px;">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="admin-card p-4 h-100" style="background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);">
            <h5 style="font-weight: 600; color: #334155; margin-bottom: 1.5rem;"><i class="fas fa-address-card text-primary me-2"></i> Thông tin Bệnh nhân</h5>
            
            <div class="text-center mb-4">
                <div style="width: 80px; height: 80px; border-radius: 50%; background: #e2e8f0; display: inline-flex; align-items: center; justify-content: center; font-size: 2.5rem; color: #94a3b8; margin-bottom: 1rem;">
                    <i class="fas fa-user-injured"></i>
                </div>
                <h5 style="font-weight: 700; margin-bottom: 0;">@appointment?.BenhNhan?.HoTen</h5>
                <span class="badge bg-secondary mt-2">ID: BN-@appointment?.MaBenhNhan.ToString("D5")</span>
            </div>

            <ul class="list-group list-group-flush" style="background: transparent;">
                <li class="list-group-item bg-transparent px-0 d-flex justify-content-between">
                    <span class="text-muted" style="font-size: 0.9rem;">Tuổi</span>
                    <strong>@(appointment?.BenhNhan != null ? DateTime.Now.Year - appointment.BenhNhan.NgaySinh.Year : 0)</strong>
                </li>
                <li class="list-group-item bg-transparent px-0 d-flex justify-content-between">
                    <span class="text-muted" style="font-size: 0.9rem;">Giới tính</span>
                    <strong>@appointment?.BenhNhan?.GioiTinh</strong>
                </li>
                <li class="list-group-item bg-transparent px-0 d-flex justify-content-between">
                    <span class="text-muted" style="font-size: 0.9rem;">Dị ứng</span>
                    @if (!string.IsNullOrEmpty(appointment?.BenhNhan?.DiUng))
                    {
                        <strong class="text-danger">@appointment.BenhNhan.DiUng</strong>
                    }
                    else
                    {
                        <strong>Không</strong>
                    }
                </li>
                <li class="list-group-item bg-transparent px-0">
                    <div class="text-muted mb-1" style="font-size: 0.9rem;">Triệu chứng ban đầu</div>
                    <div class="p-2" style="background: white; border-radius: 6px; border: 1px solid #e2e8f0; font-size: 0.9rem;">
                        @(string.IsNullOrEmpty(appointment?.LyDoKham) ? "Không có dữ liệu" : appointment.LyDoKham)
                    </div>
                </li>
            </ul>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="admin-card p-4">
            <h5 style="font-weight: 600; color: #334155; margin-bottom: 1.5rem;"><i class="fas fa-file-medical text-primary me-2"></i> Kết quả Khám & Chẩn đoán</h5>
            
            <form asp-action="SaveConsultation" method="post">
                <input type="hidden" asp-for="MaLichKham" />
                <input type="hidden" asp-for="MaBenhNhan" />
                <input type="hidden" asp-for="MaBacSi" />
                
                <div class="mb-4">
                    <label class="form-label" style="font-weight: 600; color: #475569;">GHI NHẬN TRIỆU CHỨNG LÂM SÀNG</label>
                    <textarea asp-for="TrieuChung" class="form-control" rows="3" style="border-radius: 8px;" placeholder="Mô tả chi tiết triệu chứng hiện tại của bệnh nhân..."></textarea>
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label mb-0" style="font-weight: 600; color: #475569;">CHẨN ĐOÁN (MÃ BỆNH) <span class="text-danger">*</span></label>
                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#templatePanel" style="border-radius: 6px; font-size: 0.8rem;">
                            <i class="fas fa-bolt me-1"></i> Template nhanh
                        </button>
                    </div>
                    
                    <!-- Template Panel -->
                    <div class="collapse mb-2" id="templatePanel">
                        <div class="p-3 border rounded" style="background: #f8fafc; border-radius: 8px !important;">
                            <div style="font-size: 0.8rem; font-weight: 600; color: #64748b; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em;">Chọn chẩn đoán thường gặp</div>
                            <div class="d-flex flex-wrap gap-2">
                                @{
                                    var templates = new[]
                                    {
                                        new { Label = "Viêm họng cấp", Code = "J02.9", Symptom = "Đau họng, nuốt đau, sốt nhẹ", Advice = "Nghỉ ngơi, uống nhiều nước ấm, tránh thức ăn cứng và cay." },
                                        new { Label = "Cảm cúm", Code = "J11", Symptom = "Sổ mũi, hắt hơi, đau đầu, sốt", Advice = "Nghỉ ngơi tại nhà, uống nhiều nước, hạ sốt khi cần." },
                                        new { Label = "Viêm dạ dày", Code = "K29.7", Symptom = "Đau bụng thượng vị, buồn nôn, ợ chua", Advice = "Ăn nhẹ, tránh rượu bia, cà phê, thức ăn cay nóng. Ăn đúng giờ." },
                                        new { Label = "Cao huyết áp", Code = "I10", Symptom = "Đau đầu, chóng mặt, huyết áp tăng cao", Advice = "Hạn chế muối, stress, nghỉ ngơi đầy đủ, tái khám định kỳ." },
                                        new { Label = "Đái tháo đường T2", Code = "E11", Symptom = "Khát nước nhiều, tiểu nhiều, mệt mỏi", Advice = "Kiểm soát chế độ ăn, luyện tập thể dục đều đặn, theo dõi đường huyết." },
                                        new { Label = "Viêm phế quản", Code = "J40", Symptom = "Ho nhiều, có đờm, tức ngực", Advice = "Nghỉ ngơi, tránh khói bụi, giữ ấm vùng ngực." },
                                        new { Label = "Đau lưng cơ học", Code = "M54.5", Symptom = "Đau vùng thắt lưng, khó cúi", Advice = "Chườm ấm, tránh mang vác nặng, ngủ nệm cứng." },
                                        new { Label = "Rối loạn lo âu", Code = "F41.1", Symptom = "Lo lắng quá mức, hồi hộp, mất ngủ", Advice = "Giảm căng thẳng, thở sâu, tập thể dục nhẹ. Tái khám nếu không cải thiện." },
                                    };
                                    foreach (var t in templates)
                                    {
                                        <button type="button" class="btn btn-sm btn-light template-btn"
                                            style="border-radius: 8px; border: 1px solid #e2e8f0; font-size: 0.78rem; padding: 4px 10px;"
                                            data-chandoan="@t.Label (@t.Code)"
                                            data-trieuchung="@t.Symptom"
                                            data-loidan="@t.Advice">
                                            @t.Label
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                    
                    <input asp-for="ChanDoan" type="text" class="form-control" style="border-radius: 8px; padding: 0.6rem 1rem;" required placeholder="Ví dụ: Viêm họng cấp (J02.9)" />
                    <span asp-validation-for="ChanDoan" class="text-danger"></span>
                </div>
                
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label" style="font-weight: 600; color: #475569;">LỜI DẶN BÁC SĨ</label>
                        <textarea asp-for="LoiDan" class="form-control" rows="4" style="border-radius: 8px;" placeholder="Dặn dò chế độ ăn uống, nghỉ ngơi..."></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" style="font-weight: 600; color: #475569;">GHI CHÚ NỘI BỘ</label>
                        <textarea asp-for="GhiChu" class="form-control" rows="4" style="border-radius: 8px;" placeholder="Ghi chú thêm (không in ra phiếu)"></textarea>
                    </div>
                </div>

                <hr class="my-4" />
                
                <div class="d-flex justify-content-between align-items-center">
                    <div class="text-muted" style="font-size: 0.85rem;">
                        <i class="fas fa-info-circle me-1"></i> Dùng Template nhanh để điền tự động các trường chẩn đoán.
                    </div>
                    <button type="submit" class="btn btn-primary" style="background: var(--admin-sidebar-bg); border: none; border-radius: 8px; font-weight: 600; padding: 0.6rem 1.5rem;">
                        <i class="fas fa-save me-2"></i> Lưu & Hoàn tất Khám
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.querySelectorAll('.template-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
        // Fill in the fields
        var chanDoan = this.getAttribute('data-chandoan');
        var trieuChung = this.getAttribute('data-trieuchung');
        var loiDan = this.getAttribute('data-loidan');

        document.getElementById('ChanDoan').value = chanDoan;
        if (document.getElementById('TrieuChung').value === '')
            document.getElementById('TrieuChung').value = trieuChung;
        if (document.getElementById('LoiDan').value === '')
            document.getElementById('LoiDan').value = loiDan;

        // Visual feedback
        document.querySelectorAll('.template-btn').forEach(b => b.classList.remove('btn-primary', 'active'));
        this.classList.add('btn-primary');
        this.classList.remove('btn-light');

        // Auto-close template panel
        var collapseEl = document.getElementById('templatePanel');
        bootstrap.Collapse.getOrCreateInstance(collapseEl).hide();
    });
});
</script>
}

