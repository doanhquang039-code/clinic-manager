@{
    ViewData["Title"] = "Doctor Dashboard";
    Layout = "_PortalLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 style="font-weight: 700; color: var(--admin-text-dark); margin-bottom: 2px;">Lịch khám hôm nay</h4>
        <div style="color: var(--admin-text-muted); font-size: 0.9rem;">Danh sách bệnh nhân đang chờ khám</div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="admin-card p-4 text-center">
            <h5 class="text-success"><i class="fas fa-stethoscope fa-3x mb-3"></i></h5>
            <h4>Khu vực làm việc của Bác sĩ</h4>
            <p class="text-muted">Tính năng gọi bệnh nhân vào phòng, lập phiếu khám bệnh và kê đơn thuốc sẽ được thực hiện tại đây.</p>
        </div>
    </div>
</div>
