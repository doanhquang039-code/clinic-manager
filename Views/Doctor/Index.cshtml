@model List<MyMvcApp.Models.LichKham>
@{
    ViewData["Title"] = "Bảng điều khiển Bác sĩ";
    Layout = "_PortalLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 style="font-weight: 700; color: var(--admin-text-dark); margin-bottom: 2px;">Bảng điều khiển Bác sĩ</h4>
        <div style="color: var(--admin-text-muted); font-size: 0.9rem;">Lịch khám bệnh ngày hôm nay (@DateTime.Today.ToString("dd/MM/yyyy"))</div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert" style="border-radius: 8px;">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert" style="border-radius: 8px;">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@{
    var pendingAppointments = ViewBag.PendingAppointments as List<MyMvcApp.Models.LichKham> ?? new List<MyMvcApp.Models.LichKham>();
}

@if (pendingAppointments.Any())
{
    <div class="alert alert-warning mb-4" style="border-radius: 8px; border-left: 5px solid #f59e0b;">
        <h6 style="font-weight: 700; color: #92400e; margin-bottom: 10px;"><i class="fas fa-bell me-2"></i> Có @pendingAppointments.Count lịch khám đang chờ xác nhận</h6>
        <div class="table-responsive">
            <table class="table table-sm table-borderless mb-0">
                <tbody>
                    @foreach (var appt in pendingAppointments)
                    {
                        <tr style="border-bottom: 1px solid rgba(0,0,0,0.05);">
                            <td style="vertical-align: middle; width: 20%; font-weight: 600; color: #475569;">
                                @appt.NgayKham.ToString("dd/MM/yyyy") - @appt.GioKham.ToString(@"hh\:mm")
                            </td>
                            <td style="vertical-align: middle; width: 40%;">
                                <span style="font-weight: 600;">@appt.BenhNhan?.HoTen</span> <br/>
                                <span style="font-size: 0.8rem; color: #64748b;">@appt.LyDoKham</span>
                            </td>
                            <td style="vertical-align: middle; width: 40%; text-align: right;">
                                <form asp-action="ApproveAppointment" method="post" style="display:inline;">
                                    <input type="hidden" name="id" value="@appt.MaLichKham" />
                                    <input type="hidden" name="action" value="approve" />
                                    <button type="submit" class="btn btn-sm btn-success" style="border-radius:6px;">
                                        <i class="fas fa-check"></i> Duyệt
                                    </button>
                                </form>
                                <form asp-action="ApproveAppointment" method="post" style="display:inline;">
                                    <input type="hidden" name="id" value="@appt.MaLichKham" />
                                    <input type="hidden" name="action" value="reject" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius:6px;">
                                        <i class="fas fa-times"></i> Hủy
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="admin-table-container">
    <div class="p-3 border-bottom bg-light d-flex justify-content-between align-items-center">
        <h6 class="mb-0" style="font-weight: 600; color: #475569;"><i class="fas fa-list-ul me-2"></i> Danh sách bệnh nhân chờ khám</h6>
        <span class="badge bg-primary rounded-pill">@Model.Count bệnh nhân</span>
    </div>

    @if (Model != null && Model.Any())
    {
        <table class="admin-table">
            <thead>
                <tr>
                    <th style="width: 15%">GIỜ KHÁM</th>
                    <th style="width: 25%">BỆNH NHÂN</th>
                    <th style="width: 20%">SỐ ĐIỆN THOẠI</th>
                    <th style="width: 25%">LÝ DO / TRIỆU CHỨNG</th>
                    <th style="width: 15%; text-align: center;">THAO TÁC</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="font-weight: 600; color: #4f46e5;">@item.GioKham.ToString(@"hh\:mm")</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div style="width: 32px; height: 32px; border-radius: 50%; background: #e2e8f0; display: flex; align-items: center; justify-content: center; color: #64748b;">
                                    <i class="fas fa-user"></i>
                                </div>
                                <span style="font-weight: 500;">@item.BenhNhan?.HoTen</span>
                            </div>
                        </td>
                        <td>@item.BenhNhan?.SoDienThoai</td>
                        <td>
                            <span class="text-truncate d-inline-block text-muted" style="max-width: 200px;">
                                @(string.IsNullOrEmpty(item.LyDoKham) ? "-" : item.LyDoKham)
                            </span>
                        </td>
                        <td style="text-align: center;">
                            @if (item.TrangThai == "ChoXacNhan")
                            {
                                <div class="d-flex gap-1 justify-content-center">
                                    <form asp-action="ApproveAppointment" method="post" style="display:inline;">
                                        <input type="hidden" name="id" value="@item.MaLichKham" />
                                        <input type="hidden" name="action" value="approve" />
                                        <button type="submit" class="btn btn-sm btn-success" style="border-radius:6px;" title="Xác nhận">
                                            <i class="fas fa-check"></i> Duyệt
                                        </button>
                                    </form>
                                    <form asp-action="ApproveAppointment" method="post" style="display:inline;">
                                        <input type="hidden" name="id" value="@item.MaLichKham" />
                                        <input type="hidden" name="action" value="reject" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius:6px;" title="Hủy">
                                            <i class="fas fa-times"></i> Hủy
                                        </button>
                                    </form>
                                </div>
                            }
                            else if (item.TrangThai == "DaXacNhan")
                            {
                                <a asp-action="Consultation" asp-route-id="@item.MaLichKham" class="btn btn-sm btn-primary" style="border-radius: 6px; font-weight: 500;">
                                    <i class="fas fa-stethoscope me-1"></i> Khám bệnh
                                </a>
                            }
                            else if (item.TrangThai == "DaHuy")
                            {
                                <span class="badge bg-danger" style="padding: 0.5rem 0.8rem;"><i class="fas fa-times me-1"></i> Đã hủy</span>
                            }
                            else
                            {
                                <span class="badge bg-success" style="padding: 0.5rem 0.8rem;"><i class="fas fa-check me-1"></i> Hoàn thành</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="p-5 text-center text-muted">
            <i class="fas fa-mug-hot fa-3x mb-3" style="color: #cbd5e1;"></i>
            <h5>Tuyệt vời! Bạn không có lịch khám nào trong hôm nay.</h5>
            <p>Hãy dành thời gian nghỉ ngơi hoặc kiểm tra lại lịch sử khám bệnh.</p>
        </div>
    }
</div>
