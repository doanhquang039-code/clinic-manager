<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Portal</title>
    @inject MyMvcApp.Models.ApplicationDbContext DbContext
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var currentRoute = currentAction;
        var userRole = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Admin";
        var userName = User.Identity?.Name ?? "User";
        var initial = userName.Substring(0, 1).ToUpper();
    }

    <!-- Sidebar -->
    <div class="admin-sidebar">
        <div class="admin-logo">
            <div class="admin-logo-icon">
                <i class="fas fa-heartbeat"></i>
            </div>
            <div>
                <div style="line-height: 1.2;">MediCore</div>
                <div style="font-size: 0.75rem; font-weight: 400; color: rgba(255,255,255,0.7);">Admin Portal</div>
            </div>
        </div>

        <div class="admin-nav">
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Admin" asp-action="Index" class="admin-nav-item @(currentRoute == "Index" ? "active" : "")">
                    <i class="fas fa-server"></i> Tổng quan
                </a>
                <a asp-controller="Admin" asp-action="Accounts" class="admin-nav-item @(currentRoute == "Accounts" ? "active" : "")">
                    <i class="fas fa-user-shield"></i> Quản lý tài khoản
                </a>
                <a asp-controller="Admin" asp-action="Specialties" class="admin-nav-item @(currentRoute == "Specialties" ? "active" : "")">
                    <i class="fas fa-stethoscope"></i> Quản lý Chuyên khoa
                </a>
                <a asp-controller="Admin" asp-action="Services" class="admin-nav-item @(currentRoute == "Services" ? "active" : "")">
                    <i class="fas fa-concierge-bell"></i> Quản lý Dịch vụ
                </a>
                <a asp-controller="Admin" asp-action="Logs" class="admin-nav-item @(currentRoute == "Logs" ? "active" : "")">
                    <i class="fas fa-clipboard-list"></i> Nhật ký hệ thống
                </a>
            }
            else if (User.IsInRole("Manager"))
            {
                <a asp-controller="Manager" asp-action="Index" class="admin-nav-item @(currentRoute == "Index" ? "active" : "")">
                    <i class="fas fa-chart-pie"></i> Tổng quan
                </a>
                <a asp-controller="Manager" asp-action="Schedules" class="admin-nav-item @(currentRoute == "Schedules" ? "active" : "")">
                    <i class="fas fa-calendar-alt"></i> Quản lý Lịch khám
                </a>
                <a asp-controller="Manager" asp-action="Personnel" class="admin-nav-item @(currentRoute == "Personnel" ? "active" : "")">
                    <i class="fas fa-users-cog"></i> Quản lý Nhân sự
                </a>
                <a asp-controller="Manager" asp-action="Patients" class="admin-nav-item @(currentRoute == "Patients" ? "active" : "")">
                    <i class="fas fa-procedures"></i> Quản lý Bệnh nhân
                </a>
                <a asp-controller="Manager" asp-action="DrugStock" class="admin-nav-item @(currentRoute == "DrugStock" ? "active" : "")">
                    <i class="fas fa-pills"></i> Kho Dược
                </a>
                <a asp-controller="Manager" asp-action="Invoices" class="admin-nav-item @(currentRoute == "Invoices" ? "active" : "")">
                    <i class="fas fa-file-invoice-dollar"></i> Hóa đơn
                </a>
                <a asp-controller="Manager" asp-action="Reports" class="admin-nav-item @(currentRoute == "Reports" ? "active" : "")">
                    <i class="fas fa-chart-line"></i> Báo cáo toàn diện
                </a>
            }
            else if (User.IsInRole("BacSi"))
            {
                <a asp-controller="Doctor" asp-action="Index" class="admin-nav-item @(currentRoute == "Index" ? "active" : "")">
                    <i class="fas fa-calendar-check"></i> Lịch hẹn hôm nay
                </a>
                <a asp-controller="Doctor" asp-action="Appointments" class="admin-nav-item @(currentRoute == "Appointments" ? "active" : "")">
                    <i class="fas fa-list-alt"></i> Quản lý Đơn hẹn
                </a>
                <a asp-controller="Doctor" asp-action="MonthlySchedule" class="admin-nav-item @(currentRoute == "MonthlySchedule" ? "active" : "")">
                    <i class="fas fa-calendar-alt"></i> Lịch cả tháng
                </a>
                <a asp-controller="Doctor" asp-action="History" class="admin-nav-item @(currentRoute == "History" ? "active" : "")">
                    <i class="fas fa-history"></i> Lịch sử ca khám
                </a>
                <a asp-controller="Doctor" asp-action="Profile" class="admin-nav-item @(currentRoute == "Profile" ? "active" : "")">
                    <i class="fas fa-user-md"></i> Hồ sơ bác sĩ
                </a>
            }
            else if (User.IsInRole("ThuNgan"))
            {
                <a asp-controller="Cashier" asp-action="Index" class="admin-nav-item @(currentRoute == "Index" ? "active" : "")">
                    <i class="fas fa-wallet"></i> Hàng đợi thu tiền
                </a>
                <a asp-controller="Cashier" asp-action="Invoices" class="admin-nav-item @(currentRoute == "Invoices" ? "active" : "")">
                    <i class="fas fa-file-invoice-dollar"></i> Danh sách Hóa đơn
                </a>
                <a asp-controller="Cashier" asp-action="RevenueReport" class="admin-nav-item @(currentRoute == "RevenueReport" ? "active" : "")">
                    <i class="fas fa-chart-pie"></i> Báo cáo doanh thu
                </a>
                <a asp-controller="Cashier" asp-action="DaySummary" class="admin-nav-item @(currentRoute == "DaySummary" ? "active" : "")">
                    <i class="fas fa-chart-bar"></i> Tổng kết cuối ngày
                </a>
                <a asp-controller="Cashier" asp-action="History" class="admin-nav-item @(currentRoute == "History" ? "active" : "")">
                    <i class="fas fa-receipt"></i> Lịch sử giao dịch
                </a>
                <a asp-controller="Cashier" asp-action="Expenses" class="admin-nav-item @(currentRoute == "Expenses" || currentRoute == "CreateExpense" ? "active" : "")">
                    <i class="fas fa-money-bill-wave"></i> Quản lý phiếu chi
                </a>
                <a asp-controller="Cashier" asp-action="Inventory" class="admin-nav-item @(currentRoute == "Inventory" || currentRoute == "CreateDrug" || currentRoute == "EditDrug" ? "active" : "")">
                    <i class="fas fa-boxes"></i> Quản lý kho thuốc
                </a>
            }
            else if (User.IsInRole("LeTan"))
            {
                <a asp-controller="Staff" asp-action="Index" class="admin-nav-item @(currentController == "Staff" && currentAction == "Index" ? "active" : "")">
                    <i class="fas fa-home"></i> Tổng quan
                </a>
                <a asp-controller="Staff" asp-action="Appointments" class="admin-nav-item @(currentController == "Staff" && currentAction == "Appointments" ? "active" : "")">
                    <i class="fas fa-calendar-check"></i> Lịch hẹn đặt trước
                </a>
                <a asp-controller="Staff" asp-action="Tracking" class="admin-nav-item @(currentController == "Staff" && currentAction == "Tracking" ? "active" : "")">
                    <i class="fas fa-user-md"></i> Trạng thái Bác sĩ
                </a>
                <a asp-controller="LichKham" asp-action="Index" class="admin-nav-item @(currentController == "LichKham" ? "active" : "")">
                    <i class="fas fa-calendar-alt"></i> Quản lý Lịch khám
                </a>
                <a asp-controller="BenhNhan" asp-action="Index" class="admin-nav-item @(currentController == "BenhNhan" ? "active" : "")">
                    <i class="fas fa-user-injured"></i> Hồ sơ Bệnh nhân
                </a>
                <a asp-controller="PhieuKham" asp-action="Index" class="admin-nav-item @(currentController == "PhieuKham" ? "active" : "")">
                    <i class="fas fa-stethoscope"></i> Quản lý Ca khám
                </a>
                <a asp-controller="Cashier" asp-action="Invoices" class="admin-nav-item @(currentController == "Cashier" && currentAction == "Invoices" ? "active" : "")">
                    <i class="fas fa-file-invoice-dollar"></i> Quản lý Hóa đơn
                </a>
                <a asp-controller="Cashier" asp-action="Inventory" class="admin-nav-item @(currentController == "Cashier" && (currentAction == "Inventory" || currentAction == "CreateDrug" || currentAction == "EditDrug") ? "active" : "")">
                    <i class="fas fa-pills"></i> Thuốc tồn kho
                </a>
                <a asp-controller="DichVu" asp-action="Index" class="admin-nav-item @(currentController == "DichVu" ? "active" : "")">
                    <i class="fas fa-concierge-bell"></i> Bảng giá Dịch vụ
                </a>
                <hr class="border-secondary my-2 mx-3" style="opacity: 0.2;" />
                <a asp-controller="Staff" asp-action="Profile" class="admin-nav-item @(currentController == "Staff" && currentAction == "Profile" ? "active" : "")">
                    <i class="fas fa-user-circle"></i> Hồ sơ cá nhân
                </a>
                <a asp-controller="Staff" asp-action="Settings" class="admin-nav-item @(currentController == "Staff" && currentAction == "Settings" ? "active" : "")">
                    <i class="fas fa-cog"></i> Cài đặt
                </a>
            }
            else if (User.IsInRole("BenhNhan"))
            {
                <a asp-controller="Patient" asp-action="Index" class="admin-nav-item @(currentRoute == "Index" ? "active" : "")">
                    <i class="fas fa-home"></i> Dashboard
                </a>
                <a asp-controller="Patient" asp-action="BookAppointment" class="admin-nav-item @(currentRoute == "BookAppointment" ? "active" : "")">
                    <i class="fas fa-calendar-plus"></i> Đặt lịch khám
                </a>
                <a asp-controller="Patient" asp-action="MedicalRecords" class="admin-nav-item @(currentRoute == "MedicalRecords" ? "active" : "")">
                    <i class="fas fa-notes-medical"></i> Hồ sơ sức khỏe
                </a>
                <a asp-controller="Patient" asp-action="Team" class="admin-nav-item @(currentRoute == "Team" ? "active" : "")">
                    <i class="fas fa-user-md"></i> Bác sĩ & Chuyên khoa
                </a>
                <a asp-controller="Patient" asp-action="Invoices" class="admin-nav-item @(currentRoute == "Invoices" || currentRoute == "InvoiceDetail" ? "active" : "")">
                    <i class="fas fa-file-invoice-dollar"></i> Hóa đơn & Đơn thuốc
                </a>
                <a asp-controller="Patient" asp-action="Profile" class="admin-nav-item @(currentRoute == "Profile" ? "active" : "")">
                    <i class="fas fa-user-edit"></i> Thông tin cá nhân
                </a>
                <a asp-controller="Patient" asp-action="Drugs" class="admin-nav-item @(currentRoute == "Drugs" ? "active" : "")">
                    <i class="fas fa-pills"></i> Danh mục thuốc
                </a>
                <a asp-controller="Patient" asp-action="Settings" class="admin-nav-item @(currentRoute == "Settings" ? "active" : "")">
                    <i class="fas fa-cog"></i> Cài đặt
                </a>
            }
        </div>

        <div class="mt-auto">
            <div class="admin-user-profile">
                <div class="admin-avatar">@initial</div>
                <div>
                    <div style="font-weight: 600; font-size: 0.9rem;">@userName</div>
                    <div style="font-size: 0.75rem; color: rgba(255,255,255,0.7);">@userRole</div>
                </div>
            </div>
            <a asp-controller="Auth" asp-action="Logout" class="admin-nav-item m-0 rounded-0 border-top" style="border-color: rgba(255,255,255,0.05) !important;">
                <i class="fas fa-sign-out-alt"></i> Đăng xuất
            </a>
        </div>
    </div>

    <!-- Main Content -->
    <div class="admin-main">
        <div class="admin-topbar">
            <div class="admin-search">
                <i class="fas fa-search text-muted"></i>
                <input type="text" placeholder="Search patients, doctors, records..." />
            </div>
            
            <div class="admin-topbar-right">
                <div style="font-size: 0.85rem; font-weight: 500;">
                    @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
                </div>
                @{
                    int notificationCount = 0;
                    string notifLink = "#";
                    
                    if (userRole == "BacSi") {
                        var idClaim = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                        if (int.TryParse(idClaim, out int docId)) {
                            notificationCount = DbContext.LichKhams.Count(l => l.MaBacSi == docId && l.TrangThai == "ChoXacNhan");
                            notifLink = Url.Action("Appointments", "Doctor", new { status = "pending" });
                        }
                    } else if (userRole == "Manager") {
                        notificationCount = DbContext.LichKhams.Count(l => l.TrangThai == "ChoXacNhan");
                        notifLink = Url.Action("Schedules", "Manager");
                    } else if (userRole == "ThuNgan") {
                        notificationCount = DbContext.HoaDons.Count(h => h.TrangThaiThanhToan != "DaThanhToan");
                        notifLink = Url.Action("Index", "Cashier");
                    }
                }
                <a href="@notifLink" style="position: relative; cursor: pointer; color: var(--admin-text-muted); text-decoration: none;" title="Bạn có @notificationCount thông báo mới">
                    <i class="far fa-bell" style="font-size: 1.25rem;"></i>
                    @if (notificationCount > 0)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem; padding: 0.25em 0.4em;">
                            @(notificationCount > 9 ? "9+" : notificationCount.ToString())
                            <span class="visually-hidden">New alerts</span>
                        </span>
                    }
                </a>
                <div class="dropdown border-start ps-3 ms-2">
                    @{
                        string portalAvatarUrl = null;
                        var userIdClaim = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                        if (!string.IsNullOrEmpty(userIdClaim) && int.TryParse(userIdClaim, out int uid))
                        {
                            if (userRole == "BenhNhan")
                            {
                                portalAvatarUrl = DbContext.BenhNhans.Where(b => b.MaBenhNhan == uid).Select(b => b.AvatarUrl).FirstOrDefault();
                            }
                            else
                            {
                                portalAvatarUrl = DbContext.NguoiDungs.Where(n => n.MaNguoiDung == uid).Select(n => n.AvatarUrl).FirstOrDefault();
                            }
                        }
                    }
                    <a href="#" class="d-flex align-items-center gap-2 text-decoration-none" id="portalUserDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        @if (!string.IsNullOrEmpty(portalAvatarUrl))
                        {
                            <img src="@portalAvatarUrl" alt="Avatar" class="rounded-circle" style="width: 35px; height: 35px; object-fit: cover; border: 2px solid var(--primary-color);" />
                        }
                        else
                        {
                            <div class="admin-avatar" style="width: 35px; height: 35px; font-size: 0.8rem;">@initial</div>
                        }
                        <div style="line-height: 1.2; text-align: left;">
                            <div style="font-weight: 600; font-size: 0.85rem; color: var(--admin-text-dark);">@userName</div>
                            <div style="font-size: 0.7rem; color: var(--admin-text-muted);">@userRole <i class="fas fa-chevron-down ms-1"></i></div>
                        </div>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" aria-labelledby="portalUserDropdown" style="border-radius: 12px; margin-top: 10px; min-width: 200px;">
                        @{
                            var profileController = User.IsInRole("BenhNhan") ? "Patient" : "Auth";
                        }
                        <li>
                            <a class="dropdown-item py-2 d-flex align-items-center" asp-controller="@profileController" asp-action="Profile">
                                <i class="fas fa-id-card text-muted me-3"></i> Hồ sơ cá nhân
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 d-flex align-items-center" asp-controller="@profileController" asp-action="Settings">
                                <i class="fas fa-cog text-muted me-3"></i> Cài đặt tài khoản
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item py-2 d-flex align-items-center text-danger" asp-controller="Auth" asp-action="Logout">
                                <i class="fas fa-sign-out-alt me-3"></i> Đăng xuất
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="admin-content">
            @RenderBody()
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
