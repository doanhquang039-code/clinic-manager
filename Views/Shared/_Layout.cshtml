<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyMvcApp</title>
    @inject MyMvcApp.Models.ApplicationDbContext DbContext
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MyMvcApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light navbar-premium mb-5">
            <div class="container-fluid">
                <a class="navbar-brand font-weight-bold" style="color: var(--primary-color);" asp-area=""
                   asp-controller="Home" asp-action="Index">✨ Phòng Khám</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index"><i
                                class="fas fa-home"></i> Trang chủ</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="LichKham" asp-action="Index">
                                    <i class="fas fa-calendar-alt text-warning me-1"></i> Lịch Khám
                                </a>
                            </li>

                            @if (User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("LeTan") ||
                                                    User.IsInRole("BacSi"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="PhieuKham" asp-action="Index">
                                        <i class="fas fa-notes-medical text-success me-1"></i> Phiếu Khám
                                    </a>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" id="navbarDropdown" role="button"
                                       data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fas fa-cogs text-secondary me-1"></i> Quản lý
                                    </a>
                                    <ul class="dropdown-menu border-0 shadow" aria-labelledby="navbarDropdown">
                                        <li><a class="dropdown-item" asp-area="" asp-controller="NguoiDung"
                                                   asp-action="Index"><i class="fas fa-user-shield me-2"></i>Nhân viên</a></li>
                                            <li><a class="dropdown-item" asp-area="" asp-controller="BenhNhan" asp-action="Index"><i
                                                class="fas fa-procedures me-2"></i>Bệnh nhân</a></li>
                                                <li>
                                                    <hr class="dropdown-divider">
                                                </li>
                                                <li><a class="dropdown-item" asp-area="" asp-controller="ChuyenKhoa"
                                                           asp-action="Index"><i class="fas fa-clinic-medical me-2"></i>Chuyên khoa</a>
                                                </li>
                                                <li><a class="dropdown-item" asp-area="" asp-controller="Thuoc" asp-action="Index"><i
                                                    class="fas fa-pills me-2"></i>Thuốc</a></li>
                                                    <li><a class="dropdown-item" asp-area="" asp-controller="DichVu" asp-action="Index"><i
                                                        class="fas fa-stethoscope me-2"></i>Dịch vụ</a></li>
                                                    </ul>
                                                </li>
                                            }
                                        </ul>

                                        <ul class="navbar-nav">
                                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                                            {
                                                var role = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value;
                                                
                                                string avatarUrl = null;
                                                var userIdClaim = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                                                if (!string.IsNullOrEmpty(userIdClaim) && int.TryParse(userIdClaim, out int uid))
                                                {
                                                    if (role == "BenhNhan")
                                                    {
                                                        avatarUrl = DbContext.BenhNhans.Where(b => b.MaBenhNhan == uid).Select(b => b.AvatarUrl).FirstOrDefault();
                                                    }
                                                    else
                                                    {
                                                        avatarUrl = DbContext.NguoiDungs.Where(n => n.MaNguoiDung == uid).Select(n => n.AvatarUrl).FirstOrDefault();
                                                    }
                                                }
                                                <li class="nav-item dropdown me-2 mt-1">
                                                    <a class="nav-link dropdown-toggle d-flex align-items-center text-dark text-decoration-none" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                        @if (!string.IsNullOrEmpty(avatarUrl))
                                                        {
                                                            <img src="@avatarUrl" alt="Avatar" class="rounded-circle me-2" style="width: 35px; height: 35px; object-fit: cover; border: 2px solid var(--primary-color);" />
                                                        }
                                                        else
                                                        {
                                                            <i class="fas fa-user-circle text-primary fs-3 me-2"></i>
                                                        }
                                                        <div class="d-flex flex-column text-start lh-1">
                                                            <span class="fw-bold" style="font-size: 0.95rem;">@User.Identity.Name</span>
                                                            <span class="text-muted" style="font-size: 0.75rem;">@role</span>
                                                        </div>
                                                    </a>
                                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="userDropdown" style="border-radius: 12px; margin-top: 10px;">
                                                        @{
                                                            var profileController = User.IsInRole("BenhNhan") ? "Patient" : "Auth";
                                                        }
                                                        <li>
                                                            <a class="dropdown-item py-2 d-flex align-items-center" asp-controller="@profileController" asp-action="Profile">
                                                                <i class="fas fa-id-card text-muted me-3"></i> Hồ sơ cá nhân
                                                            </a>
                                                        </li>
                                                        <li>
                                                            <a class="dropdown-item py-2 d-flex align-items-center" asp-controller="@profileController" asp-action="Settings">
                                                                <i class="fas fa-cog text-muted me-3"></i> Cài đặt tài khoản
                                                            </a>
                                                        </li>
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li>
                                                            <a class="dropdown-item py-2 d-flex align-items-center text-danger" asp-controller="Auth" asp-action="Logout">
                                                                <i class="fas fa-sign-out-alt me-3"></i> Đăng xuất
                                                            </a>
                                                        </li>
                                                    </ul>
                                                </li>
                                            }
                        else
                                                    {
                                                        <li class="nav-item me-2">
                                                            <a class="btn btn-outline-primary" asp-controller="Auth" asp-action="Login">Đăng nhập</a>
                                                        </li>
                                                        <li class="nav-item">
                                                            <a class="btn btn-premium" asp-controller="Auth" asp-action="Register">Đăng ký</a>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        </div>
                                    </nav>
                                </header>
                                <div class="container">
                                    <main role="main" class="pb-3">
                                        @RenderBody()
                                    </main>
                                </div>


                                <script src="~/lib/jquery/dist/jquery.min.js"></script>
                                <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
                                <script src="~/js/site.js" asp-append-version="true"></script>
                                @await RenderSectionAsync("Scripts", required: false)
                            </body>

                        </html>
