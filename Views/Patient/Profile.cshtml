@model MyMvcApp.Models.BenhNhan
@{
    ViewData["Title"] = "Thông tin cá nhân";
    Layout = "_PortalLayout";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted mb-2 d-inline-block"><i class="fas fa-arrow-left me-1"></i> Quay lại Dashboard</a>
    <h4 style="font-weight:700;color:var(--admin-text-dark);margin-bottom:2px;">Thông tin cá nhân</h4>
    <div style="color:var(--admin-text-muted);font-size:0.9rem;">Cập nhật thông tin liên lạc và y tế của bạn</div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" style="border-radius:8px;">@TempData["SuccessMessage"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="row">
    <div class="col-lg-4 mb-4">
        <div class="admin-card p-4 text-center h-100" style="background:linear-gradient(135deg,#1e293b,#0f172a);color:white;border:none;">
            <div style="width:90px;height:90px;border-radius:50%;background:rgba(255,255,255,0.1);display:inline-flex;align-items:center;justify-content:center;font-size:2.5rem;font-weight:700;margin-bottom:1rem;">
                @Model.HoTen.Substring(0,1).ToUpper()
            </div>
            <h5 style="font-weight:700;margin-bottom:4px;">@Model.HoTen</h5>
            <p style="color:#94a3b8;font-size:0.85rem;margin-bottom:1.5rem;">BN-@Model.MaBenhNhan.ToString("D5")</p>

            <div class="text-start">
                <div class="d-flex justify-content-between py-2 border-top" style="border-color:rgba(255,255,255,0.1)!important;">
                    <span style="color:#94a3b8;font-size:0.85rem;">Ngày sinh</span>
                    <span style="font-weight:500;font-size:0.85rem;">@Model.NgaySinh.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="d-flex justify-content-between py-2 border-top" style="border-color:rgba(255,255,255,0.1)!important;">
                    <span style="color:#94a3b8;font-size:0.85rem;">Giới tính</span>
                    <span style="font-weight:500;font-size:0.85rem;">@Model.GioiTinh</span>
                </div>
                <div class="d-flex justify-content-between py-2 border-top" style="border-color:rgba(255,255,255,0.1)!important;">
                    <span style="color:#94a3b8;font-size:0.85rem;">Email</span>
                    <span style="font-weight:500;font-size:0.78rem;word-break:break-all;">@(Model.Email ?? "-")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="admin-card p-4">
            <h6 style="font-weight:600;color:#334155;margin-bottom:1.5rem;"><i class="fas fa-edit text-primary me-2"></i>Chỉnh sửa thông tin</h6>
            <form asp-action="UpdateProfile" method="post">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" style="font-size:0.85rem;">SỐ ĐIỆN THOẠI</label>
                        <div class="input-group">
                            <span class="input-group-text" style="border-radius:8px 0 0 8px;"><i class="fas fa-phone text-muted"></i></span>
                            <input name="SoDienThoai" class="form-control" style="border-radius:0 8px 8px 0;" value="@Model.SoDienThoai" placeholder="0xxxxxxxxx" />
                        </div>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label fw-semibold" style="font-size:0.85rem;">ĐỊA CHỈ</label>
                        <div class="input-group">
                            <span class="input-group-text" style="border-radius:8px 0 0 8px;"><i class="fas fa-map-marker-alt text-muted"></i></span>
                            <input name="DiaChi" class="form-control" style="border-radius:0 8px 8px 0;" value="@Model.DiaChi" placeholder="Số nhà, đường, quận/huyện, tỉnh/thành" />
                        </div>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label fw-semibold" style="font-size:0.85rem;">DỊ ỨNG (thuốc, thực phẩm...)</label>
                        <div class="input-group">
                            <span class="input-group-text" style="border-radius:8px 0 0 8px;"><i class="fas fa-allergies text-danger"></i></span>
                            <input name="DiUng" class="form-control" style="border-radius:0 8px 8px 0;" value="@Model.DiUng" placeholder="Ví dụ: Penicillin, Hải sản... (Để trống nếu không có)" />
                        </div>
                        <div class="form-text text-warning"><i class="fas fa-exclamation-triangle me-1"></i>Thông tin dị ứng rất quan trọng, bác sĩ sẽ dựa vào đây để kê đơn.</div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light" style="border-radius:8px;">Hủy bỏ</a>
                    <button type="submit" class="btn" style="background:var(--admin-sidebar-bg);color:white;border-radius:8px;font-weight:600;padding:0.6rem 1.5rem;">
                        <i class="fas fa-save me-2"></i> Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
