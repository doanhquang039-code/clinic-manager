@model List<MyMvcApp.Models.PhieuKham>
@{
    ViewData["Title"] = "Lịch sử khám bệnh";
    Layout = "_PortalLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted mb-2 d-inline-block"><i class="fas fa-arrow-left me-1"></i> Quay lại Dashboard</a>
        <h4 style="font-weight: 700; color: var(--admin-text-dark); margin-bottom: 2px;">Kết quả khám bệnh</h4>
        <div style="color: var(--admin-text-muted); font-size: 0.9rem;">Toàn bộ hồ sơ và chỉ định từ bác sĩ</div>
    </div>
</div>

<div class="admin-table-container">
    @if (Model != null && Model.Any())
    {
        <table class="admin-table">
            <thead>
                <tr>
                    <th style="width: 15%">NGÀY KHÁM</th>
                    <th style="width: 25%">BÁC SĨ</th>
                    <th style="width: 25%">CHẨN ĐOÁN</th>
                    <th style="width: 20%">TRIỆU CHỨNG</th>
                    <th style="width: 15%; text-align: center;">CHI TIẾT</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="font-weight: 500;">@item.NgayKham?.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div style="width: 30px; height: 30px; border-radius: 50%; background: #e2e8f0; display: flex; align-items: center; justify-content: center;">
                                    <i class="fas fa-user-md text-primary"></i>
                                </div>
                                <span>@item.BacSi?.HoTen</span>
                            </div>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ChanDoan))
                            {
                                <span style="color: var(--admin-text-dark); font-weight: 500;">@item.ChanDoan</span>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">Chưa có chẩn đoán</span>
                            }
                        </td>
                        <td>
                            <span class="text-truncate d-inline-block" style="max-width: 150px;">
                                @(string.IsNullOrEmpty(item.TrieuChung) ? "-" : item.TrieuChung)
                            </span>
                        </td>
                        <td style="text-align: center;">
                            <a asp-action="RecordDetail" asp-route-id="@item.MaPhieuKham" class="btn btn-sm btn-outline-primary" style="border-radius: 6px;">
                                <i class="fas fa-eye me-1"></i> Xem
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="p-5 text-center text-muted">
            <i class="fas fa-folder-open fa-3x mb-3 text-light"></i>
            <h5>Chưa có dữ liệu khám bệnh</h5>
            <p>Bạn chưa có kết quả khám nào được lưu trên hệ thống.</p>
        </div>
    }
</div>
