@model List<MyMvcApp.Models.PhieuKham>
@{
    ViewData["Title"] = "Lịch sử khám bệnh";
    Layout = "_PortalLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted mb-2 d-inline-block"><i class="fas fa-arrow-left me-1"></i> Quay lại Dashboard</a>
        <h4 style="font-weight: 700; color: var(--admin-text-dark); margin-bottom: 2px;">Kết quả khám bệnh</h4>
        <div style="color: var(--admin-text-muted); font-size: 0.9rem;">Toàn bộ hồ sơ và chỉ định từ bác sĩ</div>
    </div>
</div>

<div class="admin-table-container">
    @if (Model != null && Model.Any())
    {
        <table class="admin-table">
            <thead>
                <tr>
                    <th style="width: 15%">NGÀY KHÁM</th>
                    <th style="width: 25%">BÁC SĨ</th>
                    <th style="width: 25%">CHẨN ĐOÁN</th>
                    <th style="width: 20%">TRIỆU CHỨNG</th>
                    <th style="width: 15%; text-align: center;">CHI TIẾT</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="font-weight: 500;">@item.NgayKham?.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div style="width: 30px; height: 30px; border-radius: 50%; background: #e2e8f0; display: flex; align-items: center; justify-content: center;">
                                    <i class="fas fa-user-md text-primary"></i>
                                </div>
                                <span>@item.BacSi?.HoTen</span>
                            </div>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ChanDoan))
                            {
                                <span style="color: var(--admin-text-dark); font-weight: 500;">@item.ChanDoan</span>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">Chưa có chẩn đoán</span>
                            }
                        </td>
                        <td>
                            <span class="text-truncate d-inline-block" style="max-width: 150px;">
                                @(string.IsNullOrEmpty(item.TrieuChung) ? "-" : item.TrieuChung)
                            </span>
                        </td>
                        <td style="text-align: center;">
                            <div class="d-flex gap-1 justify-content-center">
                                <a asp-action="RecordDetail" asp-route-id="@item.MaPhieuKham" class="btn btn-sm btn-outline-primary" style="border-radius: 6px;">
                                    <i class="fas fa-eye me-1"></i> Xem
                                </a>
                                @if (item.DanhGia == null)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-warning" style="border-radius: 6px;"
                                        onclick="openRateModal(@item.MaPhieuKham, '@item.BacSi?.HoTen')"
                                        title="Đánh giá bác sĩ">
                                        <i class="fas fa-star"></i>
                                    </button>
                                }
                                else
                                {
                                    <span class="btn btn-sm btn-warning disabled" style="border-radius: 6px; opacity: 1;" title="Đã đánh giá @item.DanhGia sao">
                                        @for (int s = 1; s <= item.DanhGia; s++) { <text>★</text> }
                                    </span>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="p-5 text-center text-muted">
            <i class="fas fa-folder-open fa-3x mb-3 text-light"></i>
            <h5>Chưa có dữ liệu khám bệnh</h5>
            <p>Bạn chưa có kết quả khám nào được lưu trên hệ thống.</p>
        </div>
    }
</div>

<!-- Rating Modal -->
<div class="modal fade" id="ratingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content" style="border-radius: 16px; border: none;">
            <div class="modal-header border-bottom-0 text-center d-block pt-4">
                <h5 class="modal-title" style="font-weight: 700;">Đánh giá bác sĩ</h5>
                <div style="font-size: 0.85rem; color: #64748b;" id="rateDocName"></div>
            </div>
            <form asp-action="RateDoctor" method="post">
                <div class="modal-body text-center pb-0">
                    <input type="hidden" name="phieuKhamId" id="rate-phieuKhamId" />
                    
                    <div class="star-rating d-flex justify-content-center gap-2 mb-4" style="font-size: 2.5rem;">
                        @for (int i = 5; i >= 1; i--)
                        {
                            <input type="radio" name="rating" id="star@(i)" value="@i" style="display:none;" />
                            <label for="star@(i)" style="cursor:pointer; color: #e2e8f0; transition: color 0.15s;" data-value="@i">★</label>
                        }
                    </div>
                    
                    <div class="mb-3 text-start">
                        <label class="form-label fw-semibold" style="font-size: 0.85rem;">Nhận xét (tuỳ chọn)</label>
                        <textarea name="review" class="form-control" rows="3" placeholder="Chia sẻ cảm nhận của bạn về bác sĩ..." style="border-radius: 8px;"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pb-4 justify-content-center">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius: 8px;">Bỏ qua</button>
                    <button type="submit" class="btn btn-warning" style="border-radius: 8px; font-weight: 600;">
                        <i class="fas fa-paper-plane me-1"></i> Gửi đánh giá
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
function openRateModal(phieuKhamId, docName) {
    document.getElementById('rate-phieuKhamId').value = phieuKhamId;
    document.getElementById('rateDocName').textContent = docName;
    new bootstrap.Modal(document.getElementById('ratingModal')).show();
}

// Star rating interactive
const labels = document.querySelectorAll('.star-rating label');
labels.forEach(function(label) {
    label.addEventListener('mouseover', function() {
        var val = parseInt(this.getAttribute('data-value'));
        labels.forEach(function(l) {
            l.style.color = parseInt(l.getAttribute('data-value')) <= val ? '#f59e0b' : '#e2e8f0';
        });
    });
    label.addEventListener('click', function() {
        var val = parseInt(this.getAttribute('data-value'));
        document.getElementById('star' + val).checked = true;
        labels.forEach(function(l) {
            l.style.color = parseInt(l.getAttribute('data-value')) <= val ? '#f59e0b' : '#e2e8f0';
        });
    });
});

document.querySelector('.star-rating').addEventListener('mouseleave', function() {
    var checked = document.querySelector('.star-rating input:checked');
    var val = checked ? parseInt(checked.value) : 0;
    labels.forEach(function(l) {
        l.style.color = parseInt(l.getAttribute('data-value')) <= val ? '#f59e0b' : '#e2e8f0';
    });
});
</script>
}
