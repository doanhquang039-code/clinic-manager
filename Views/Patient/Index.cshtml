@{
    ViewData["Title"] = "My Health Dashboard";
    Layout = "_PortalLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 style="font-weight: 700; color: var(--admin-text-dark); margin-bottom: 2px;">Sức khỏe của tôi</h4>
        <div style="color: var(--admin-text-muted); font-size: 0.9rem;">Hồ sơ y tế cá nhân</div>
    </div>
    <button class="btn" style="background: var(--admin-sidebar-bg); color: white; border-radius: 8px; padding: 0.5rem 1.25rem; font-weight: 500;">
        <i class="fas fa-calendar-plus me-2"></i> Đặt lịch khám mới
    </button>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="admin-card p-4 text-center">
            <h5 class="text-warning"><i class="fas fa-notes-medical fa-3x mb-3"></i></h5>
            <h4>Khu vực dành cho Bệnh nhân</h4>
            <p class="text-muted">Lịch sử khám chữa bệnh, đơn thuốc và hóa đơn thanh toán sẽ được lưu trữ tại đây.</p>
        </div>
    </div>
</div>
