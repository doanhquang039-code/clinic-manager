@{
    ViewData["Title"] = "Cài đặt ứng dụng";
    Layout = "~/Views/Shared/_PortalLayout.cshtml";
    
    bool smsNotif = ViewBag.SmsNotification ?? true;
    bool emailNotif = ViewBag.EmailNotification ?? true;
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-0 pt-4 pb-0">
                    <h4 class="mb-0 text-primary"><i class="fas fa-cog me-2"></i> Cài đặt cá nhân</h4>
                    <p class="text-muted mt-2">Tùy chỉnh thông báo và các thiết lập tài khoản của bạn.</p>
                </div>
                <div class="card-body p-4">
                    
                    <h5 class="fw-bold mb-3 border-bottom pb-2">Tùy chọn Thông báo</h5>
                    
                    <div class="form-check form-switch fs-5 mb-3">
                        <input class="form-check-input" type="checkbox" id="smsNotif" checked="@smsNotif">
                        <label class="form-check-label fs-6 ms-2" for="smsNotif">
                            <strong>Nhận thông báo qua SMS / Zalo</strong>
                            <div class="text-muted small">Hệ thống sẽ gửi tin nhắn nhắc nhở trước ngày khám 1 ngày.</div>
                        </label>
                    </div>

                    <div class="form-check form-switch fs-5 mb-4">
                        <input class="form-check-input" type="checkbox" id="emailNotif" checked="@emailNotif">
                        <label class="form-check-label fs-6 ms-2" for="emailNotif">
                            <strong>Nhận thông báo qua Email</strong>
                            <div class="text-muted small">Nhận thông báo về lịch khám, hóa đơn và kết quả qua Email.</div>
                        </label>
                    </div>

                    <h5 class="fw-bold mb-3 border-bottom pb-2 mt-5">Bảo mật tài khoản</h5>
                    
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <strong>Đổi mật khẩu</strong>
                            <div class="text-muted small">Bảo vệ tài khoản của bạn bằng mật khẩu mạnh.</div>
                        </div>
                        <button class="btn btn-outline-primary btn-sm rounded-pill px-3">Cập nhật</button>
                    </div>
                    
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <strong>Xác thực 2 bước (2FA)</strong>
                            <div class="text-muted small">Thêm một lớp bảo mật khi đăng nhập.</div>
                        </div>
                        <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" disabled>Đang phát triển</button>
                    </div>

                    <div class="mt-5 pt-3 border-top text-end">
                        <button class="btn btn-primary rounded-pill px-4" onclick="saveSettings()"><i class="fas fa-save me-1"></i> Lưu Cài đặt</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function saveSettings() {
            // Simulated save action
            const btn = document.querySelector('button.btn-primary');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Đang lưu...';
            btn.disabled = true;
            
            setTimeout(() => {
                btn.innerHTML = '<i class="fas fa-check me-1"></i> Đã lưu thành công!';
                btn.classList.replace('btn-primary', 'btn-success');
                
                setTimeout(() => {
                    btn.innerHTML = originalText;
                    btn.classList.replace('btn-success', 'btn-primary');
                    btn.disabled = false;
                }, 2000);
            }, 800);
        }
    </script>
}
