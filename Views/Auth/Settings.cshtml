@{
    ViewData["Title"] = "Cài đặt tài khoản";
    Layout = "_PortalLayout";
}

<div class="premium-card">
    <h4 class="fw-bold mb-4"><i class="fas fa-cog text-primary me-2"></i>Cài đặt tài khoản</h4>
    
    <div class="row">
        <div class="col-md-6 mb-3">
            <div class="admin-card p-4 border h-100" style="border-radius: 12px; background: transparent; box-shadow: none;">
                <h6 class="fw-bold"><i class="fas fa-lock text-warning me-2"></i>Bảo mật</h6>
                <p class="text-muted small">Cập nhật mật khẩu và xác thực hai yếu tố.</p>
                <button class="btn btn-outline-primary btn-sm mt-2" disabled>Đổi mật khẩu (Đang bảo trì)</button>
            </div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="admin-card p-4 border h-100" style="border-radius: 12px; background: transparent; box-shadow: none;">
                <h6 class="fw-bold"><i class="fas fa-bell text-info me-2"></i>Thông báo</h6>
                <p class="text-muted small">Quản lý cách nhận thông báo từ hệ thống.</p>
                <div class="form-check form-switch mt-3">
                    <input class="form-check-input" type="checkbox" id="emailNotif" checked disabled>
                    <label class="form-check-label" for="emailNotif">Nhận thông báo qua Email</label>
                </div>
            </div>
        </div>
    </div>
</div>
