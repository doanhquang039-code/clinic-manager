@model MyMvcApp.Models.PhieuChi
@{
    ViewData["Title"] = "Lập Phiếu Chi Mới";
    Layout = "~/Views/Shared/_PortalLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-0 pt-4 pb-0">
                    <h4 class="mb-0 text-primary"><i class="fas fa-file-invoice-dollar me-2"></i> Lập Phiếu Chi Mới</h4>
                    <p class="text-muted mt-2">Nhập thông tin phiếu chi, hoàn tiền hoặc thanh toán nội bộ.</p>
                </div>
                <div class="card-body p-4">
                    <form asp-action="CreateExpense" method="post">
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label class="form-label fw-bold">Loại Phiếu Chi <span class="text-danger">*</span></label>
                                <select asp-for="LoaiPhieu" class="form-select" required>
                                    <option value="">-- Chọn loại phiếu --</option>
                                    <option value="HoanTien">Hoàn tiền cho bệnh nhân</option>
                                    <option value="NhapThuoc">Chi nhập thuốc/VTYT</option>
                                    <option value="ChiKhac">Chi khác (Điện, nước, văn phòng phẩm...)</option>
                                </select>
                                <span asp-validation-for="LoaiPhieu" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-12">
                                <label class="form-label fw-bold">Số Tiền (VNĐ) <span class="text-danger">*</span></label>
                                <input asp-for="SoTien" type="number" class="form-control text-danger fw-bold fs-5" required min="1000" />
                                <span asp-validation-for="SoTien" class="text-danger"></span>
                                <small class="text-muted">Nhập số tiền tối thiểu 1.000 VNĐ</small>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label fw-bold">Lý Do Chi Tiết <span class="text-danger">*</span></label>
                                <textarea asp-for="LyDo" class="form-control" rows="3" required placeholder="Ghi rõ lý do xuất quỹ..."></textarea>
                                <span asp-validation-for="LyDo" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-top text-end">
                            <a asp-action="Expenses" class="btn btn-light rounded-pill px-4 me-2">Hủy bỏ</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-4">
                                <i class="fas fa-save me-1"></i> Xác Nhận & Lưu Phiếu
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
