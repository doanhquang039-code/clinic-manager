@{
    ViewData["Title"] = "Báo Cáo Doanh Thu Nâng Cao";
    Layout = "~/Views/Shared/_PortalLayout.cshtml";
    
    decimal totalRevenue = ViewBag.TotalRevenue ?? 0;
    decimal totalDrug = ViewBag.TotalDrugRevenue ?? 0;
    decimal totalService = ViewBag.TotalServiceRevenue ?? 0;
    decimal totalExpense = ViewBag.TotalExpense ?? 0;
    decimal profit = totalRevenue - totalExpense;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-0 text-primary"><i class="fas fa-chart-line me-2"></i> Báo Cáo Doanh Thu</h4>
            <p class="text-muted mt-1 mb-0">Thống kê tình hình tài chính trong @ViewBag.Days ngày qua.</p>
        </div>
        <form method="get" class="d-flex align-items-center bg-white p-2 rounded-pill shadow-sm border">
            <span class="me-2 text-muted ms-3"><i class="fas fa-filter"></i> Lọc:</span>
            <select name="days" class="form-select form-select-sm border-0 bg-transparent fw-bold" onchange="this.form.submit()">
                <option value="7" selected="@(ViewBag.Days == 7)">7 ngày qua</option>
                <option value="15" selected="@(ViewBag.Days == 15)">15 ngày qua</option>
                <option value="30" selected="@(ViewBag.Days == 30)">30 ngày qua (1 tháng)</option>
                <option value="90" selected="@(ViewBag.Days == 90)">90 ngày qua (3 tháng)</option>
            </select>
        </form>
    </div>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 rounded-4 shadow-sm bg-primary text-white h-100 overflow-hidden">
                <div class="card-body position-relative z-1">
                    <p class="mb-1 text-white-50 fw-bold text-uppercase small">Tổng Doanh Thu Khám & Thuốc</p>
                    <h3 class="fw-bold mb-0">@totalRevenue.ToString("N0") <small class="fs-6">đ</small></h3>
                </div>
                <i class="fas fa-wallet position-absolute opacity-25" style="font-size: 5rem; right: -10px; bottom: -10px; z-index: 0"></i>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 rounded-4 shadow-sm bg-success text-white h-100 overflow-hidden">
                <div class="card-body position-relative z-1">
                    <p class="mb-1 text-white-50 fw-bold text-uppercase small">Tỷ trọng Tiền Thuốc</p>
                    <h3 class="fw-bold mb-0">@totalDrug.ToString("N0") <small class="fs-6">đ</small></h3>
                    <small class="opacity-75">
                        @(totalRevenue > 0 ? Math.Round((totalDrug / totalRevenue) * 100, 1) : 0)% tổng thu
                    </small>
                </div>
                <i class="fas fa-pills position-absolute opacity-25" style="font-size: 5rem; right: -10px; bottom: -10px; z-index: 0"></i>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 rounded-4 shadow-sm bg-danger text-white h-100 overflow-hidden">
                <div class="card-body position-relative z-1">
                    <p class="mb-1 text-white-50 fw-bold text-uppercase small">Tổng Chi (Phiếu chi, Nhập...)</p>
                    <h3 class="fw-bold mb-0">@totalExpense.ToString("N0") <small class="fs-6">đ</small></h3>
                </div>
                <i class="fas fa-money-bill-wave position-absolute opacity-25" style="font-size: 5rem; right: -10px; bottom: -10px; z-index: 0"></i>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 rounded-4 shadow-sm @(profit >= 0 ? "bg-info" : "bg-secondary") text-white h-100 overflow-hidden">
                <div class="card-body position-relative z-1">
                    <p class="mb-1 text-white-50 fw-bold text-uppercase small">Lợi Nhuận Tạm Tính</p>
                    <h3 class="fw-bold mb-0">@profit.ToString("N0") <small class="fs-6">đ</small></h3>
                </div>
                <i class="fas fa-coins position-absolute opacity-25" style="font-size: 5rem; right: -10px; bottom: -10px; z-index: 0"></i>
            </div>
        </div>
    </div>

    <!-- Charts -->
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 rounded-4 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-4 pb-0">
                    <h6 class="fw-bold text-dark mb-0">Biểu Đồ Thu / Chi Theo Ngày</h6>
                </div>
                <div class="card-body">
                    <canvas id="revenueChart" height="100"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 rounded-4 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-4 pb-0">
                    <h6 class="fw-bold text-dark mb-0">Cơ Cấu Doanh Thu</h6>
                </div>
                <div class="card-body d-flex justify-content-center align-items-center">
                    <div style="width: 80%">
                        <canvas id="pieChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- CDN Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Line chart Thu Chi
            var ctxLine = document.getElementById('revenueChart').getContext('2d');
            var revenueChart = new Chart(ctxLine, {
                type: 'line',
                data: {
                    labels: [@Html.Raw(ViewBag.ChartLabels)],
                    datasets: [{
                        label: 'Doanh Thu Khám & Thuốc',
                        data: [@ViewBag.ChartRevenue],
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13, 110, 253, 0.1)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.4
                    }, {
                        label: 'Tiền Chi Xuất Quỹ',
                        data: [@ViewBag.ChartExpense],
                        borderColor: '#dc3545',
                        backgroundColor: 'rgba(220, 53, 69, 0.1)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'top' }
                    },
                    scales: {
                        y: { beginAtZero: true }
                    }
                }
            });

            // Pie chart Cơ cấu
            var ctxPie = document.getElementById('pieChart').getContext('2d');
            var pieChart = new Chart(ctxPie, {
                type: 'doughnut',
                data: {
                    labels: ['Khám & Dịch Vụ', 'Tiền Thuốc'],
                    datasets: [{
                        data: [@totalService, @totalDrug],
                        backgroundColor: ['#ffc107', '#198754'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });
        });
    </script>
}
