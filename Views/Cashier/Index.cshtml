@{
    ViewData["Title"] = "Cashier Dashboard";
    Layout = "_PortalLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 style="font-weight: 700; color: var(--admin-text-dark); margin-bottom: 2px;">Thu ngân</h4>
        <div style="color: var(--admin-text-muted); font-size: 0.9rem;">Tổng quan thu chi trong ca trực</div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="admin-card p-4 text-center">
            <h5 class="text-danger"><i class="fas fa-wallet fa-3x mb-3"></i></h5>
            <h4>Khu vực dành cho Thu ngân</h4>
            <p class="text-muted">Chức năng quản lý hóa đơn, thu tiền bệnh nhân và báo cáo dòng tiền sẽ được thực hiện tại đây.</p>
        </div>
    </div>
</div>
