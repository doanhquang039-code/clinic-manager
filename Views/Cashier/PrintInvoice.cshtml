@model MyMvcApp.Models.HoaDon
@{
    ViewData["Title"] = $"Hóa đơn HD-{Model.MaHoaDon:D5}";
    Layout = null; // Không dùng layout để in được sạch
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Hóa đơn HD-@Model.MaHoaDon.ToString("D5")</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Segoe UI', Arial, sans-serif; font-size: 13px; color: #1a1a1a; background: white; }
        .container { max-width: 680px; margin: 0 auto; padding: 24px; }
        .header { text-align: center; border-bottom: 2px solid #1e293b; padding-bottom: 16px; margin-bottom: 20px; }
        .clinic-name { font-size: 20px; font-weight: 700; color: #1e293b; }
        .clinic-sub { font-size: 11px; color: #64748b; margin-top: 2px; }
        .invoice-title { font-size: 18px; font-weight: 700; text-align: center; margin: 16px 0 4px; text-transform: uppercase; letter-spacing: 2px; }
        .invoice-meta { display: flex; justify-content: space-between; margin-bottom: 20px; background: #f8fafc; padding: 12px 16px; border-radius: 8px; }
        .meta-item { font-size: 12px; }
        .meta-item .label { color: #64748b; margin-bottom: 2px; }
        .meta-item .value { font-weight: 600; }
        .section-title { font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; color: #475569; margin: 16px 0 8px; border-bottom: 1px solid #e2e8f0; padding-bottom: 6px; }
        .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 24px; margin-bottom: 16px; }
        .info-item { display: flex; flex-direction: column; }
        .info-item .label { font-size: 11px; color: #64748b; margin-bottom: 1px; }
        .info-item .value { font-weight: 600; }
        .bill-table { width: 100%; border-collapse: collapse; margin: 12px 0; }
        .bill-table th { background: #1e293b; color: white; padding: 8px 12px; text-align: left; font-size: 11px; }
        .bill-table td { padding: 8px 12px; border-bottom: 1px solid #f1f5f9; }
        .bill-table tr:last-child td { border: none; }
        .total-row { font-weight: 700; font-size: 15px; display: flex; justify-content: space-between; background: #f0f9ff; padding: 12px 16px; border-radius: 8px; margin-top: 8px; color: #0369a1; }
        .footer { text-align: center; margin-top: 32px; font-size: 11px; color: #94a3b8; }
        .stamp { display: inline-block; border: 3px solid #22c55e; color: #22c55e; font-weight: 700; font-size: 13px; padding: 6px 18px; border-radius: 8px; transform: rotate(-5deg); margin-top: 8px; }
        @@media print {
            body { padding: 0; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <div class="clinic-name">🏥 MEDICORE CLINIC</div>
            <div class="clinic-sub">Hệ thống Quản lý Phòng khám — medicore.com</div>
        </div>

        <div class="invoice-title">Hóa đơn thanh toán</div>
        <div style="text-align:center;font-size:11px;color:#64748b;margin-bottom:16px;">HD-@Model.MaHoaDon.ToString("D5")</div>

        <!-- Meta -->
        <div class="invoice-meta">
            <div class="meta-item">
                <div class="label">Ngày lập hóa đơn</div>
                <div class="value">@Model.NgayLap?.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
            <div class="meta-item">
                <div class="label">Thu ngân</div>
                <div class="value">@Model.NguoiLap?.HoTen</div>
            </div>
            <div class="meta-item">
                <div class="label">Hình thức thanh toán</div>
                <div class="value">@(Model.PhuongThucThanhToan == "TienMat" ? "Tiền mặt" : Model.PhuongThucThanhToan == "ChuyenKhoan" ? "Chuyển khoản" : "Thẻ ngân hàng")</div>
            </div>
        </div>

        <!-- Bệnh nhân -->
        <div class="section-title">Thông tin Bệnh nhân</div>
        <div class="info-grid">
            <div class="info-item">
                <div class="label">Họ và tên</div>
                <div class="value">@Model.PhieuKham?.BenhNhan?.HoTen</div>
            </div>
            <div class="info-item">
                <div class="label">Số điện thoại</div>
                <div class="value">@Model.PhieuKham?.BenhNhan?.SoDienThoai</div>
            </div>
        </div>

        <!-- Bác sĩ -->
        <div class="section-title">Thông tin Điều trị</div>
        <div class="info-grid">
            <div class="info-item">
                <div class="label">Bác sĩ điều trị</div>
                <div class="value">@Model.PhieuKham?.BacSi?.HoTen</div>
            </div>
            <div class="info-item">
                <div class="label">Chuyên khoa</div>
                <div class="value">@Model.PhieuKham?.BacSi?.ChuyenKhoa?.TenChuyenKhoa</div>
            </div>
        </div>

        <!-- Chi tiết phí -->
        <div class="section-title">Chi tiết Phí dịch vụ</div>
        <table class="bill-table">
            <thead>
                <tr>
                    <th>Khoản mục</th>
                    <th style="text-align:right;">Số tiền</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Phí khám bệnh</td>
                    <td style="text-align:right;">@String.Format("{0:N0}", Model.TienDichVu)đ</td>
                </tr>
                <tr>
                    <td>Tiền thuốc & vật tư</td>
                    <td style="text-align:right;">@String.Format("{0:N0}", Model.TienThuoc)đ</td>
                </tr>
            </tbody>
        </table>

        <div class="total-row">
            <span>TỔNG CỘNG</span>
            <span>@String.Format("{0:N0}", Model.TongTien)đ</span>
        </div>

        <div style="text-align:center;margin-top:20px;">
            <div class="stamp">ĐÃ THANH TOÁN ✓</div>
        </div>

        <div class="footer">
            <p>Cảm ơn quý bệnh nhân đã tin tưởng sử dụng dịch vụ của chúng tôi!</p>
            <p style="margin-top:4px;">MediCore Clinic — Hotline: 1800-xxxx</p>
        </div>
    </div>

    <!-- Nút in (ẩn khi in) -->
    <div class="no-print" style="text-align:center;padding:20px;background:#f8fafc;border-top:1px solid #e2e8f0;">
        <button onclick="window.print()" class="btn" style="background:#1e293b;color:white;padding:0.6rem 2rem;border-radius:8px;border:none;font-weight:600;margin-right:8px;">
            🖨️ In hóa đơn
        </button>
        <a href="javascript:history.back()" style="text-decoration:none;color:#64748b;padding:0.6rem 1.5rem;">← Quay lại</a>
    </div>
</body>
</html>
