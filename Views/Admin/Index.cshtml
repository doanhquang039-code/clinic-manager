@model MyMvcApp.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
    
    var userName = User.Identity?.Name ?? "User";
    var lastName = userName.Split(' ').Last();
    var initial = lastName.Substring(0, 1).ToUpper();
}

<div class="mb-4">
    <h3 style="font-weight: 700; color: var(--admin-text-dark); margin-bottom: 5px;">Admin Dashboard</h3>
    <p style="color: var(--admin-text-muted); font-size: 0.9rem;">Welcome back, @initial. @lastName — here's what's happening today.</p>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-4 col-lg-2">
        <div class="admin-card stat-card h-100">
            <div class="stat-icon" style="background: #f1f5f9; color: #475569;">
                <i class="fas fa-user-friends"></i>
            </div>
            <div>
                <div class="stat-title">Total Accounts</div>
                <div class="stat-value">@Model.TotalAccounts.ToString("N0")</div>
                <div class="stat-growth growth-up">
                    <i class="fas fa-arrow-trend-up"></i> @Model.TotalAccountsGrowth vs last month
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-4 col-lg-2">
        <div class="admin-card stat-card h-100">
            <div class="stat-icon" style="background: #e0f2fe; color: #0284c7;">
                <i class="fas fa-user-md"></i>
            </div>
            <div>
                <div class="stat-title">Doctors</div>
                <div class="stat-value">@Model.TotalDoctors.ToString("N0")</div>
                <div class="stat-growth growth-up">
                    <i class="fas fa-arrow-trend-up"></i> @Model.DoctorsGrowth vs last month
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-4 col-lg-2">
        <div class="admin-card stat-card h-100">
            <div class="stat-icon" style="background: #e0f2fe; color: #0284c7;">
                <i class="fas fa-users"></i>
            </div>
            <div>
                <div class="stat-title">Staff</div>
                <div class="stat-value">@Model.TotalStaff.ToString("N0")</div>
                <div class="stat-growth growth-up">
                    <i class="fas fa-arrow-trend-up"></i> @Model.StaffGrowth vs last month
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-4 col-lg-2">
        <div class="admin-card stat-card h-100">
            <div class="stat-icon" style="background: #dcfce7; color: #16a34a;">
                <i class="fas fa-heartbeat"></i>
            </div>
            <div>
                <div class="stat-title">Patients</div>
                <div class="stat-value">@Model.TotalPatients.ToString("N0")</div>
                <div class="stat-growth growth-up">
                    <i class="fas fa-arrow-trend-up"></i> @Model.PatientsGrowth vs last month
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-4 col-lg-2">
        <div class="admin-card stat-card h-100">
            <div class="stat-icon" style="background: #dcfce7; color: #16a34a;">
                <i class="fas fa-user-check"></i>
                <span class="badge bg-success position-absolute mt-4" style="font-size: 0.5rem; opacity: 0.8">Active</span>
            </div>
            <div>
                <div class="stat-title">Active Accounts</div>
                <div class="stat-value">@Model.ActiveAccounts.ToString("N0")</div>
                <div class="stat-growth growth-up">
                    <i class="fas fa-arrow-trend-up"></i> @Model.ActiveAccountsGrowth vs last month
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-4 col-lg-2">
        <div class="admin-card stat-card h-100">
            <div class="stat-icon" style="background: #fee2e2; color: #dc2626;">
                <i class="fas fa-user-lock"></i>
                <span class="badge bg-danger position-absolute mt-4" style="font-size: 0.5rem; opacity: 0.8">Locked</span>
            </div>
            <div>
                <div class="stat-title">Locked Accounts</div>
                <div class="stat-value">@Model.LockedAccounts.ToString("N0")</div>
                <div class="stat-growth growth-down">
                    <i class="fas fa-arrow-trend-down"></i> @Model.LockedAccountsGrowth vs last month
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mb-3">
    <h5 style="font-weight: 700; color: var(--admin-text-dark); margin-bottom: 2px;">Analytics Overview</h5>
    <p style="color: var(--admin-text-muted); font-size: 0.85rem;">Live metrics for the past 12 months</p>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="admin-card h-100">
            <div style="font-weight: 600; margin-bottom: 2px;">User Distribution</div>
            <div style="font-size: 0.8rem; color: var(--admin-text-muted); margin-bottom: 20px;">Accounts by role</div>
            <div style="position: relative; height: 200px; width: 100%;">
                <canvas id="userDistChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="admin-card h-100">
            <div style="font-weight: 600; margin-bottom: 2px;">New Registrations</div>
            <div style="font-size: 0.8rem; color: var(--admin-text-muted); margin-bottom: 20px;">Monthly account signups (last 12 months)</div>
            <div style="position: relative; height: 200px; width: 100%;">
                <canvas id="newRegChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="admin-card h-100">
            <div style="font-weight: 600; margin-bottom: 2px;">System Activity</div>
            <div style="font-size: 0.8rem; color: var(--admin-text-muted); margin-bottom: 20px;">Hourly traffic - today</div>
            <div style="position: relative; height: 200px; width: 100%;">
                <canvas id="sysActivityChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Chart 1: User Distribution (Doughnut)
            const ctx1 = document.getElementById('userDistChart').getContext('2d');
            new Chart(ctx1, {
                type: 'doughnut',
                data: {
                    labels: ['Patients', 'Doctors', 'Staff', 'Admins'],
                    datasets: [{
                        data: [@Model.TotalPatients, @Model.TotalDoctors, @Model.TotalStaff, 10],
                        backgroundColor: ['#60a5fa', '#a78bfa', '#34d399', '#fbbf24'],
                        borderWidth: 0,
                        cutout: '70%'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, padding: 15, font: { size: 11 } } } }
                }
            });

            // Chart 2: New Registrations (Bar)
            const ctx2 = document.getElementById('newRegChart').getContext('2d');
            new Chart(ctx2, {
                type: 'bar',
                data: {
                    labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
                    datasets: [{
                        label: 'Signups',
                        data: [65, 59, 80, 81, 56, 55, 40, 70, 90, 110, 140, 160],
                        backgroundColor: '#3b82f6',
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { display: false, grid: { display: false } },
                        x: { grid: { display: false }, ticks: { font: { size: 10 } } }
                    }
                }
            });

            // Chart 3: System Activity (Line area)
            const ctx3 = document.getElementById('sysActivityChart').getContext('2d');
            
            // Create gradient
            let gradient = ctx3.createLinearGradient(0, 0, 0, 200);
            gradient.addColorStop(0, 'rgba(59, 130, 246, 0.4)');
            gradient.addColorStop(1, 'rgba(59, 130, 246, 0)');

            new Chart(ctx3, {
                type: 'line',
                data: {
                    labels: ['00', '04', '08', '12', '16', '20', '24'],
                    datasets: [{
                        label: 'Traffic',
                        data: [10, 5, 40, 80, 100, 60, 20],
                        borderColor: '#3b82f6',
                        backgroundColor: gradient,
                        borderWidth: 2,
                        tension: 0.4,
                        fill: true,
                        pointRadius: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { display: false, grid: { display: false } },
                        x: { grid: { display: false }, ticks: { font: { size: 10 } } }
                    }
                }
            });
        });
    </script>
}
